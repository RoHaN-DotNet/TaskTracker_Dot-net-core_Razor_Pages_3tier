@page
@model TaskTracker.Pages.Roles.IndexModel

@{
    ViewData["Title"] = "Role List";
}


<div class="container-fluid px-4 py-4">

    <!-- ========================================= -->
    <!-- PAGE HEADER -->
    <!-- ========================================= -->

    <div class="mb-3">

        <h1 class="page-title">
            Role List
        </h1>

        <p class="page-subtitle">
            Manage roles and their information
        </p>

    </div>


    <!-- ========================================= -->
    <!-- SUCCESS MESSAGE -->
    <!-- ========================================= -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="mdi mdi-check-circle me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ========================================= -->
    <!-- ERROR MESSAGE -->
    <!-- ========================================= -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="mdi mdi-alert-circle me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ========================================= -->
    <!-- ROLE CARD -->
    <!-- ========================================= -->

    <div class="role-card">


        <!-- ========================================= -->
        <!-- TOOLBAR -->
        <!-- ========================================= -->

        <div class="table-toolbar">


            <!-- SEARCH -->

            <div class="search-wrapper">

                <span class="search-icon">
                    <i class="mdi mdi-magnify"></i>
                </span>

                <input type="text"
                       id="roleSearch"
                       class="search-input"
                       placeholder="Search roles..." />

            </div>


            <!-- ADD BUTTON -->

            <button type="button"
                    class="btn-add"
                    data-bs-toggle="modal"
                    data-bs-target="#addRoleModal">

                <i class="bi bi-plus-circle"></i>

                Add

            </button>

        </div>



        <!-- ========================================= -->
        <!-- ROLE TABLE -->
        <!-- ========================================= -->

        <div class="table-responsive">

            <table class="role-table"
                   id="roleTable">

                <thead>

                    <tr>

                        <th>
                            Role
                        </th>

                        <th>
                            Description
                        </th>

                        <th>
                            Users Assigned
                        </th>

                        <th>
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model.Roles != null && Model.Roles.Any())
                    {

                        foreach (var role in Model.Roles)
                        {

                            <tr>


                                <!-- ================================= -->
                                <!-- ROLE -->
                                <!-- ================================= -->

                                <td>

                                    <div class="role-info">

                                        <div class="role-icon">

                                            <i class="mdi mdi-account-group"></i>

                                        </div>


                                        <div>

                                            <div class="role-name">
                                                @role.Name
                                            </div>

                                        </div>

                                    </div>

                                </td>



                                <!-- ================================= -->
                                <!-- DESCRIPTION -->
                                <!-- ================================= -->

                                <td>

                                    @if (string.IsNullOrWhiteSpace(role.Description))
                                    {
                                        <span class="description-empty">
                                            No description
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="description-text">
                                            @role.Description
                                        </span>
                                    }

                                </td>



                                <!-- ================================= -->
                                <!-- USERS ASSIGNED -->
                                <!-- ================================= -->

                                <td>

                                    <span class="user-count">
                                        @role.TotalUsersAssigned
                                    </span>

                                    <span class="user-text">

                                        @(role.TotalUsersAssigned == 1
                                            ? "user"
                                            : "users")

                                    </span>

                                </td>



                                <!-- ================================= -->
                                <!-- ACTION -->
                                <!-- ================================= -->

                                <td>

                                    @if (
                                        role.Name.Equals(
                                            "Admin",
                                            StringComparison.OrdinalIgnoreCase
                                        )
                                        ||
                                        role.Name.Equals(
                                            "Manager",
                                            StringComparison.OrdinalIgnoreCase
                                        )
                                    )
                                    {

                                        <!-- PROTECTED ROLE -->

                                        <span class="protected-role">

                                            <i class="mdi mdi-lock"></i>

                                            Protected

                                        </span>

                                    }
                                    else
                                    {

                                        <div class="action-buttons">


                                            <!-- ======================= -->
                                            <!-- EDIT -->
                                            <!-- ======================= -->

                                            <button type="button"
                                                    class="btn-edit"
                                                    title="Edit Role"
                                                    onclick="openEditModal(
                                                @role.Id,
                                                '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(role.Name))',
                                                '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(role.Description ?? ""))'
                                                )">

                                                <i class="mdi mdi-pencil"></i>

                                            </button>



                                            <!-- ======================= -->
                                            <!-- DELETE -->
                                            <!-- ======================= -->

                                            <button type="button"
                                                    class="btn-delete"
                                                    title="Delete Role"
                                                    onclick="confirmDelete(
                                                @role.Id,
                                                '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(role.Name))'
                                                )">

                                                <i class="mdi mdi-delete"></i>

                                            </button>

                                        </div>

                                    }

                                </td>

                            </tr>

                        }

                    }
                    else
                    {

                        <!-- NO ROLES -->

                        <tr>

                            <td colspan="4"
                                class="empty-row">

                                <i class="mdi mdi-account-group"></i>

                                <div>
                                    No roles found.
                                </div>

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>



        <!-- ========================================= -->
        <!-- TABLE FOOTER -->
        <!-- ========================================= -->

        <div class="table-footer">

            <span>

                Showing

                <strong>
                    @Model.Roles.Count
                </strong>

                @(Model.Roles.Count == 1
                    ? "role"
                    : "roles")

            </span>

        </div>

    </div>

</div>



<!-- ====================================================== -->
<!-- ADD ROLE MODAL -->
<!-- ====================================================== -->

<div class="modal fade"
     id="addRoleModal"
     tabindex="-1"
     aria-labelledby="addRoleModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">


            <!-- HEADER -->

            <div class="modal-header">

                <h5 class="modal-title"
                    id="addRoleModalLabel">

                    <i class="mdi mdi-plus me-2"></i>

                    Add New Role

                </h5>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>



            <!-- FORM -->

            <form method="post"
                  asp-page-handler="Create">


                <div class="modal-body">


                    <!-- ROLE NAME -->

                    <div class="mb-3">

                        <label asp-for="CreateRole.Name"
                               class="form-label">

                            Role Name

                        </label>


                        <input asp-for="CreateRole.Name"
                               class="form-control"
                               placeholder="Enter role name"
                               autocomplete="off"
                               required />


                        <span asp-validation-for="CreateRole.Name"
                              class="text-danger">
                        </span>

                    </div>



                    <!-- DESCRIPTION -->

                    <div class="mb-3">

                        <label asp-for="CreateRole.Description"
                               class="form-label">

                            Description

                        </label>


                        <textarea asp-for="CreateRole.Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Enter role description"></textarea>


                        <span asp-validation-for="CreateRole.Description"
                              class="text-danger">
                        </span>

                    </div>

                </div>



                <!-- FOOTER -->

                <div class="modal-footer">

                    <button type="button"
                            class="btn-cancel"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <button type="submit"
                            class="btn-save">

                        <i class="mdi mdi-plus me-1"></i>

                        Add Role

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



<!-- ====================================================== -->
<!-- EDIT ROLE MODAL -->
<!-- ====================================================== -->

<div class="modal fade"
     id="editRoleModal"
     tabindex="-1"
     aria-labelledby="editRoleModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">


            <!-- HEADER -->

            <div class="modal-header">

                <h5 class="modal-title"
                    id="editRoleModalLabel">

                    <i class="mdi mdi-pencil me-2"></i>

                    Edit Role

                </h5>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>



            <!-- FORM -->

            <form method="post"
                  asp-page-handler="Update">


                <div class="modal-body">


                    <!-- ROLE ID -->

                    <input asp-for="UpdateRole.Id"
                           type="hidden"
                           id="editRoleId" />



                    <!-- ROLE NAME -->

                    <div class="mb-3">

                        <label asp-for="UpdateRole.Name"
                               class="form-label">

                            Role Name

                        </label>


                        <input asp-for="UpdateRole.Name"
                               id="editRoleName"
                               class="form-control"
                               autocomplete="off"
                               required />


                        <span asp-validation-for="UpdateRole.Name"
                              class="text-danger">
                        </span>

                    </div>



                    <!-- DESCRIPTION -->

                    <div class="mb-3">

                        <label asp-for="UpdateRole.Description"
                               class="form-label">

                            Description

                        </label>


                        <textarea asp-for="UpdateRole.Description"
                                  id="editRoleDescription"
                                  class="form-control"
                                  rows="4"></textarea>


                        <span asp-validation-for="UpdateRole.Description"
                              class="text-danger">
                        </span>

                    </div>

                </div>



                <!-- FOOTER -->

                <div class="modal-footer">

                    <button type="button"
                            class="btn-cancel"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <button type="submit"
                            class="btn-save">

                        <i class="mdi mdi-content-save me-1"></i>

                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



<!-- ====================================================== -->
<!-- DELETE FORM -->
<!-- ====================================================== -->

<form method="post"
      asp-page-handler="Delete"
      id="deleteForm">

    <input type="hidden"
           name="id"
           id="deleteRoleId" />

</form>



@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>

        // =====================================================
        // SEARCH
        // =====================================================

        document
            .getElementById("roleSearch")
            .addEventListener("keyup", function() {

                const searchValue =
                    this.value.toLowerCase().trim();


                const rows =
                    document.querySelectorAll(
                        "#roleTable tbody tr"
                    );


                rows.forEach(function(row) {

                    const text =
                        row.innerText.toLowerCase();


                    if (text.includes(searchValue)) {

                        row.style.display = "";

                    }
                    else {

                        row.style.display = "none";

                    }

                });

            });



        // =====================================================
        // OPEN EDIT MODAL
        // =====================================================

        function openEditModal(
            id,
            name,
            description
        ) {

            document.getElementById(
                "editRoleId"
            ).value = id;


            document.getElementById(
                "editRoleName"
            ).value = name;


            document.getElementById(
                "editRoleDescription"
            ).value = description;


            const modalElement =
                document.getElementById(
                    "editRoleModal"
                );


            const modal =
                bootstrap.Modal.getOrCreateInstance(
                    modalElement
                );


            modal.show();

        }



        // =====================================================
        // DELETE
        // =====================================================

        function confirmDelete(
            id,
            name
        ) {

            const confirmed =
                confirm(
                    "Are you sure you want to delete the role '" +
                    name +
                    "'?"
                );


            if (!confirmed) {

                return;

            }


            document.getElementById(
                "deleteRoleId"
            ).value = id;


            document.getElementById(
                "deleteForm"
            ).submit();

        }
       
    
    </script>

}