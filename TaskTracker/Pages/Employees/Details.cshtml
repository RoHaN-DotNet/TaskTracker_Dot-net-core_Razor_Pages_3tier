@page
@model TaskTracker.Pages.Employee.DetailsModel
@{
    ViewData["Tittle"] = "employee Details";
}

    <html>
    <head>
    </head>
    <body>

        <h1>@Model.Employee.FullName</h1>

<dl class="row">
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Employee.Email</dd>

    <dt class="col-sm-3">Username</dt>
    <dd class="col-sm-9">@Model.Employee.UserName</dd>

    <dt class="col-sm-3">Company</dt>
    <dd class="col-sm-9">@Model.Employee.CompanyName</dd>

    <dt class="col-sm-3">Role(s)</dt>
    <dd class="col-sm-9">@string.Join(", ", Model.Employee.Roles)</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        @(Model.Employee.IsActive ? "Active" : "Disabled")
    </dd>

    <dt class="col-sm-3">Last Login</dt>
    <dd class="col-sm-9">@(Model.Employee.LastLoginAt?.ToString("g") ?? "Never")</dd>
</dl>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<a asp-page="/Employees/EditRole" asp-route-id="@Model.Employee.Id" class="btn btn-primary">Change Role</a>
<a asp-page="/Employees/Edit" asp-route-id="@Model.Employee.Id" class="btn btn-secondary">Edit</a>

@if (Model.Employee.IsActive)
{
    <form method="post" asp-page-handler="Disable" class="d-inline">
        <input type="hidden" name="id" value="@Model.Employee.Id" />
        <button type="submit" class="btn btn-danger"
                onclick="return confirm('Disable this employee?');">
            Disable
        </button>
    </form>
}
    </body>
    </html>

