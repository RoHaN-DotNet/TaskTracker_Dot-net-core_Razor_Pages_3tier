
@page
@model TaskTracker.Pages.Employee.IndexModel
@{
    ViewData["Title"] = "Employees";
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-lg-5" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-lg-5" role="alert">
        @Html.Raw(TempData["ErrorMessage"])
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<div class="first d-flex justify-content-between mt-lg-5"> 
    <div>
        <h1>Employee List</h1>
    </div>
    <div class=" ">
        <button class="lbtn btn-primary"
        data-bs-toggle="modal"
        data-bs-target="#createModal"
        >+ Add Employee</button>
    </div>
</div>
<div class="d-flex justify-content-end">
    
    <div>
        <form method="get" id="filterForm">
            <select asp-for="Filter.IsActive"
                    id="StatusFilter"
                    class="form-select">
                <option value="">All Employees</option>
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </select>
        </form>
    </div>
</div>
<div class=" table-responsive overflow-auto" style="max-height:500px;">
    <table id="table-main" class="table table-striped">
        <thead>
            <tr>
                <th style="width:300px;">
                    <div>
                        <form method="get" id="searchForm" class="search col-lg-4 border-opacity-50 mt-3">
                            <input asp-for="Filter.SearchTerm" id="SearchTerm" placeholder="Search by Name or Email" style="width:300px;" />
                        </form>
                    </div>
                </th>
                <th>Company Name</th>
                <th>Position</th>
                <th>Email</th>
                <th>Action</th>
                <th>Status</th>
            </tr>
        </thead>
        @if(Model.Employees is null)
        {
            <p class="text-danger">Unable to load Employees</p>
        }
        else if(Model.Employees.Count==0)
        {
            <p class="text-danger">No employee found</p>
        }
        else
        {
            <tbody>
                @foreach(var Employee in Model.Employees)
                {
                    <tr>
                        <td>@Employee.FullName</td>
                        <td>@Employee.CompanyName</td>
                        <td>@string.Join(",",Employee.Roles)</td>
                        <td>@Employee.Email</td>
                        <td >
                            <div class="d-flex justify-content-center gap-2">
                            <button class="btn btn-sm btn-outline-secondary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editModal"
                                    data-id="@Employee.Id"
                                    data-name="@Employee.FullName"
                                    data-email="@Employee.Email"
                                    data-username="@Employee.UserName"
                                    data-rolename="@Employee.Roles.FirstOrDefault()">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            </div>
                        </td>
                        <td>
                            <form method="post" asp-page-handler="ChangeStatus">
                                <input type="hidden" name="id" value="@Employee.Id" />
                                <input type="hidden" name="isActive" value="@(Employee.IsActive ? "false" : "true")" />
                                @if (Employee.IsActive)
                                {
                                    
                                    <button type="submit"
                                            class="btn p-0 border-0 bg-transparent"
                                            title="Deactivate Employee">
                                        <i class="bi bi-toggle-on fs-4 text-success"></i>
                                    </button>
                                }
                                else
                                {
                                   
                                    <button type="submit"
                                            class="btn p-0 border-0 bg-transparent"
                                            title="Activate Employee">
                                        <i class="bi bi-toggle-off fs-4"></i>
                                    </button>
                                }
                            </form>

                        </td>
                    </tr>
                }
            </tbody>
        }
    </table>
</div>

<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">

        <div class="modal-content">
            <div class="model-header">
                <h5 class="form-label">Edit Employee</h5>
            </div>
            <form method="post" asp-page-handler="update">


            <div class="modal-body">
                <input asp-for=EditEmployee.Id type="hidden" id="Id" />

                <div class="pt-3">
                    <label>Full Name</label><br />
                        <input asp-for="EditEmployee.FullName" placeholder="" id="FullName" style="width:100%" />
                </div>
                <div class="pt-3">
                    <label>Email</label><br />
                        <input asp-for="EditEmployee.Email" id="Email" style="width:100%" />
                </div>
                <div>
                        <input asp-for="EditEmployee.UserName" type="hidden" id="UserName" />
                </div>
                <div class="pt-3">
                        <select asp-for="EditEmployee.RoleName"
                                asp-items="Model.Role"
                                class="form-select"
                                id="RoleName">
                        </select>
                </div>
                

                
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header justify-content-center">
                <h3>Add a new Employee...</h3>
            </div>
            <form method="post" asp-page-handler="create">
            <div class="modal-body">
                <div>
                    <label>Full Name</label><br />
                    <input asp-for="SignupEmployee.FullName" class="form-control" style="width:100%" placeholder="User Full Name" id="fullName"/>

                </div>
                <div>
                    <label>Email</label><br />
                    <input asp-for="SignupEmployee.Email" class="form-control" style="width:100%" placeholder="User Email" />
                </div>
                <div>
                    <input type="hidden" asp-for="SignupEmployee.UserName" class="form-control" style="width:100%" id="userName"/>
                </div>
                <div>
                    <label>Password</label><br />
                    <input asp-for="SignupEmployee.Password" class="form-control" style="width:100%" placeholder="Password" />
                </div>
                <div>
                    <label>Confirm Password</label><br />
                    <input asp-for="SignupEmployee.ConfirmPassword" class="form-control" style="width:100%" placeholder="Confirm Password" />
                </div>
                <div>
                    <label>Company</label><br />
                    <select asp-for="SignupEmployee.CompanyId"
                            asp-items="Model.Companies"
                            class="form-select">
                            <option value="">--Select Company--</option>
                    </select>
                </div>
                <label>Position</label><br />
                <div class="pt-3">
                    <select asp-for="SignupEmployee.RoleName"
                            asp-items="Model.Role"
                            class="form-select"
                            id="RoleName">
                            <option value="">--Select Role--</option>
                    </select>
                </div>
                <div class="form-check form-switch">
                    <input asp-for="SignupEmployee.isActive"
                           class="form-check-input"
                           type="checkbox" />

                    <label asp-for="SignupEmployee.isActive"
                           class="form-check-label">
                        Active
                    </label>
                </div>
            </div>
            
            <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Save</button>
            </div>
            </form>
        </div>
    </div>
</div>



@section Scripts {
    <script>
        const modal = document.getElementById('editModal');

        modal.addEventListener('show.bs.modal', function (event) {

            const button = event.relatedTarget;

            document.getElementById("Id").value =
                button.getAttribute("data-id");

            document.getElementById("FullName").value =
                button.getAttribute("data-name");

            document.getElementById("Email").value =
                button.getAttribute("data-email");

            document.getElementById("UserName").value =
                button.getAttribute("data-username");

            document.getElementById("RoleName").value =
                button.getAttribute("data-rolename");

        });
        const fullName = document.getElementById("fullName");
        const userName = document.getElementById("userName");

        fullName.addEventListener("input", function () {
            userName.value = this.value
                .trim()
                .toLowerCase()
                .replace(/\s+/g, ".");
        });
        //$('#table-main').DataTable({ searching: true });
        
        let timer;

        const form = document.getElementById("searchForm");

        document.getElementById("SearchTerm")
            .addEventListener("keyup", function () {

                clearTimeout(timer);

                timer = setTimeout(function () {

                    form.submit();

                }, 1000);

            });

        document.getElementById("StatusFilter")
            .addEventListener("change", function () {

                document.getElementById("filterForm").submit();

            });

        

            
    </script>
}
