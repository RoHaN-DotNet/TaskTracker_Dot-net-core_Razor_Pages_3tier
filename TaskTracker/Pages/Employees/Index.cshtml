@page
@model TaskTracker.Pages.Employee.IndexModel
@using TaskTrackerDAL.Constants;
@{
    ViewData["Title"] = "Employees";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show employee-alert" role="alert">
        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show employee-alert" role="alert">
        @Html.Raw(TempData["ErrorMessage"])

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}


<!-- =========================================================
     PAGE HEADER
     ========================================================= -->

<div class="employee-page-header">

    <div>
        <h3 class="employee-page-title">
            Employee List
        </h3>

        <p class="employee-page-subtitle">
            Manage your employees and their information
        </p>
    </div>

</div>


<!-- =========================================================
     EMPLOYEE TABLE CARD
     ========================================================= -->

<div class="employee-table-card">

    <!-- =====================================================
         TOOLBAR
         ===================================================== -->

    <div class="employee-toolbar">

        <!-- SEARCH -->

        <div class="employee-search">

            <i class="bi bi-search employee-search-icon"></i>

            <input type="search"
                   id="employeeSearch"
                   placeholder="Search employees..."
                   autocomplete="off" />

        </div>


        <!-- TOOLBAR RIGHT -->

        <div class="employee-toolbar-right">

            <!-- FILTER -->

            <div class="employee-filter-wrapper">

                <button type="button"
                        id="filterButton"
                        class="employee-filter-button">

                    <i class="bi bi-funnel"></i>

                    <span>Filter</span>

                </button>


                <!-- FILTER PANEL -->

                <div id="filterPanel"
                     class="employee-filter-panel">

                    <div class="employee-filter-title">
                        Employee Status
                    </div>

                    <select id="statusFilter"
                            class="employee-filter-select">

                        <option value="">
                            All Employees
                        </option>

                        <option value="Active">
                            Active
                        </option>

                        <option value="Inactive">
                            Inactive
                        </option>

                    </select>


                    <button type="button"
                            id="clearFilter"
                            class="employee-filter-clear">

                        Clear filter

                    </button>

                </div>

            </div>


            <!-- SORT -->

            <div class="employee-sort">

                <span class="employee-sort-label">
                    Sort by
                </span>

                <select id="sortEmployees"
                        class="employee-sort-select">

                    <option value="0-asc">
                        Name ↑
                    </option>

                    <option value="0-desc">
                        Name ↓
                    </option>

                    <option value="1-asc">
                        Company ↑
                    </option>

                    <option value="1-desc">
                        Company ↓
                    </option>

                    <option value="2-asc">
                        Position ↑
                    </option>

                    <option value="2-desc">
                        Position ↓
                    </option>

                    <option value="3-asc">
                        Email ↑
                    </option>

                    <option value="3-desc">
                        Email ↓
                    </option>

                </select>

            </div>


            <!-- ADD EMPLOYEE -->

            <button type="button"
                    class="employee-add-button"
                    data-bs-toggle="modal"
                    data-bs-target="#createModal">

                <i class="bi bi-plus-circle"></i>

                Add 

            </button>

        </div>

    </div>


    <!-- =====================================================
         TABLE
         ===================================================== -->

    <div class="employee-table-wrapper">

        <table id="table-main"
               class="employee-datatable">

            <thead>

                <tr>

                    <th>
                        Employee
                    </th>

                    <th>
                        Company
                    </th>

                    <th>
                        Position
                    </th>

                    <th>
                        Email
                    </th>

                    <th>
                        Action
                    </th>

                    <th>
                        Status
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (Model.Employees != null)
                {
                    foreach (var employee in Model.Employees)
                    {
                        <tr>

                            <!-- EMPLOYEE -->

                            <td>

                                <div class="employee-name-cell">

                                    <div class="employee-avatar">

                                        @if (!string.IsNullOrWhiteSpace(employee.FullName))
                                        {
                                            @employee.FullName.Substring(0, 1).ToUpper()
                                        }

                                    </div>


                                    <div>

                                        <div class="employee-name">
                                            @employee.FullName
                                        </div>

                                        <div class="employee-username">
                                            @employee.UserName
                                        </div>

                                    </div>

                                </div>

                            </td>


                            <!-- COMPANY -->

                            <td>

                                <span class="employee-company">
                                    @employee.CompanyName
                                </span>

                            </td>


                            <!-- POSITION -->

                            <td>

                                <span class="employee-position">
                                    @string.Join(", ", employee.Roles)
                                </span>

                            </td>


                            <!-- EMAIL -->

                            <td>

                                <span class="employee-email">
                                    @employee.Email
                                </span>

                            </td>


                            <!-- ACTION -->

                            <td>

                                <button class="btn btn-sm btn-outline-primary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editModal"
                                        data-id="@employee.Id"
                                        data-name="@employee.FullName"
                                        data-email="@employee.Email"
                                        data-username="@employee.UserName"
                                        data-rolename="@employee.Roles.FirstOrDefault()">
                                    <i class="bi bi-pencil"></i>
                                </button>

                            </td>


                            <!-- STATUS -->

                            <td>
                                <form method="post"
                                      asp-page-handler="ChangeStatus"
                                      class="employee-status-form">

                                    <input type="hidden"
                                           name="id"
                                           value="@employee.Id" />

                                    <input type="hidden"
                                           name="isActive"
                                           value="@(employee.IsActive ? "false" : "true")" />

                                    <button type="submit"
                                            class="employee-toggle @(employee.IsActive ? "active" : "inactive")"
                                            title="@(employee.IsActive ? "Click to deactivate employee" : "Click to activate employee")"
                                            aria-label="@(employee.IsActive ? "Deactivate employee" : "Activate employee")">

                                        <span class="employee-toggle-track">

                                            <span class="employee-toggle-thumb"></span>

                                        </span>

                                        <span class="employee-status-text">
                                            @(employee.IsActive ? "Active" : "Inactive")
                                        </span>

                                    </button>

                                </form>
                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

</div>


<!-- =========================================================
     EDIT EMPLOYEE MODAL
     ========================================================= -->
<div class="modal fade"
     id="editModal"
     tabindex="-1"
     aria-labelledby="editModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content employee-edit-modal">

            <!-- HEADER -->
            <div class="modal-header employee-modal-header">

                <div>
                    <h5 class="modal-title employee-modal-title"
                        id="editModalLabel">
                        Edit Employee
                    </h5>

                    <p class="employee-modal-subtitle">
                        Update employee information and position
                    </p>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- FORM -->
            <form method="post"
                  asp-page-handler="update">

                <div class="modal-body employee-modal-body">

                    <!-- ID -->
                    <input asp-for="EditEmployee.Id"
                           type="hidden"
                           id="Id" />


                    <!-- FULL NAME -->
                    <div class="employee-form-group">

                        <label asp-for="EditEmployee.FullName"
                               class="employee-form-label">

                            Full Name

                        </label>

                        <input asp-for="EditEmployee.FullName"
                               class="form-control employee-form-control"
                               placeholder="Enter full name"
                               id="FullName" />

                    </div>


                    <!-- EMAIL -->
                    <div class="employee-form-group">

                        <label asp-for="EditEmployee.Email"
                               class="employee-form-label">

                            Email

                        </label>

                        <input asp-for="EditEmployee.Email"
                               type="email"
                               class="form-control employee-form-control"
                               placeholder="Enter email address"
                               id="Email" />

                    </div>


                    <!-- USERNAME -->
                    <div class="employee-form-group">

                        <label asp-for="EditEmployee.UserName"
                               class="employee-form-label">

                            Username

                        </label>

                        <input asp-for="EditEmployee.UserName"
                               type="text"
                               class="form-control employee-form-control employee-readonly-input"
                               id="UserName"
                               readonly />

                    </div>


                    <!-- ROLE -->
                    <div class="employee-form-group">
                        <label asp-for="EditEmployee.RoleName"
                               class="employee-form-label">
                            Position
                        </label>
                        <select asp-for="EditEmployee.RoleName"
                                asp-items="Model.Role"
                                class="form-select employee-form-control"
                                id="RoleName">
                            <option value="">
                                -- Select Position --
                            </option>
                        </select>
                    </div>
                </div>
                <!-- FOOTER -->
                <div class="modal-footer employee-modal-footer">
                    <button type="button"
                            class="btn employee-cancel-button"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit"
                            class="btn employee-save-button">
                        <i class="bi bi-check2 me-1"></i>
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- =========================================================
     CREATE EMPLOYEE MODAL
     ========================================================= -->

<div class="modal fade"
     id="createModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h3 class="modal-title">
                    Add a new Employee...
                </h3>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <form method="post"
                  asp-page-handler="create">

                <div class="modal-body">

                    <!-- FULL NAME -->

                    <div class="mb-3">

                        <label class="form-label">
                            Full Name
                        </label>

                        <input asp-for="SignupEmployee.FullName"
                               class="form-control"
                               placeholder="User Full Name"
                               id="fullName" />

                    </div>


                    <!-- EMAIL -->

                    <div class="mb-3">

                        <label class="form-label">
                            Email
                        </label>

                        <input asp-for="SignupEmployee.Email"
                               class="form-control"
                               placeholder="User Email" />

                    </div>


                    <!-- USERNAME -->

                    <input type="hidden"
                           asp-for="SignupEmployee.UserName"
                           id="userName" />


                    <!-- PASSWORD -->

                    <div class="mb-3">

                        <label class="form-label">
                            Password
                        </label>

                        <input asp-for="SignupEmployee.Password"
                               class="form-control"
                               placeholder="Password" />

                    </div>


                    <!-- CONFIRM PASSWORD -->

                    <div class="mb-3">

                        <label class="form-label">
                            Confirm Password
                        </label>

                        <input asp-for="SignupEmployee.ConfirmPassword"
                               class="form-control"
                               placeholder="Confirm Password" />

                    </div>


                    <!-- COMPANY -->
                    @if (!Model.IsManager)
                    {
                        <!-- COMPANY -->
                        <div class="mb-3">

                            <label class="form-label">
                                Company
                            </label>

                            <select asp-for="SignupEmployee.CompanyId"
                                    asp-items="Model.Companies"
                                    class="form-select">

                                <option value="">
                                    --Select Company--
                                </option>

                            </select>

                        </div>
                    }


                    <!-- ROLE -->

                    <div class="mb-3">

                        <label class="form-label">
                            Position
                        </label>

                        <select asp-for="SignupEmployee.RoleName"
                                asp-items="Model.Role"
                                class="form-select">

                            <option value="">
                                --Select Role--
                            </option>

                        </select>

                    </div>


                    <!-- ACTIVE -->

                    <div class="form-check form-switch">

                        <input asp-for="SignupEmployee.isActive"
                               class="form-check-input"
                               type="checkbox" />

                        <label asp-for="SignupEmployee.isActive"
                               class="form-check-label">

                            Active

                        </label>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        Save

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            const modal = document.getElementById('editModal');

            modal.addEventListener('show.bs.modal', function(event) {

                const button = event.relatedTarget;

                document.getElementById("Id").value =
                    button.getAttribute("data-id");

                document.getElementById("FullName").value =
                    button.getAttribute("data-name");

                document.getElementById("Email").value =
                    button.getAttribute("data-email");

                document.getElementById("UserName").value =
                    button.getAttribute("data-username");

                document.getElementById("RoleName").value =
                    button.getAttribute("data-rolename");

            });

        });


        /* =====================================================
           CREATE EMPLOYEE USERNAME
           ===================================================== */

        const fullName =
            document.getElementById("fullName");

        const userName =
            document.getElementById("userName");


        if (fullName && userName) {

            fullName.addEventListener(
                "input",
                function() {

                    userName.value =
                        this.value
                            .trim()
                            .toLowerCase()
                            .replace(/\s+/g, ".");

                }
            );

        }


        /* =====================================================
           DATATABLE
           ===================================================== */

        document.addEventListener(
            "DOMContentLoaded",
            function() {

                const tableElement =
                    document.getElementById("table-main");


                if (!tableElement) {
                    return;
                }


                const employeeTable =
                    new DataTable(
                        "#table-main",
                        {

                            /* -----------------------------
                               DEFAULT PAGE SIZE
                               ----------------------------- */

                            pageLength: 7,


                            /* -----------------------------
                               SEARCH
                               ----------------------------- */

                            searching: true,


                            /* -----------------------------
                               SORTING
                               ----------------------------- */

                            ordering: true,


                            /* -----------------------------
                               PAGINATION
                               ----------------------------- */

                            paging: true,


                            /* -----------------------------
                               INFORMATION
                               ----------------------------- */

                            info: true,


                            /* -----------------------------
                               DEFAULT SORT
                               ----------------------------- */

                            order: [
                                [0, "asc"]
                            ],


                            /* -----------------------------
                               EMPTY TABLE MESSAGE
                               ----------------------------- */

                            language: {

                                emptyTable:
                                    "No employees found",

                                zeroRecords:
                                    "No matching employees found",

                                info:
                                    "Showing _START_ to _END_ of _TOTAL_ employees",

                                infoEmpty:
                                    "Showing 0 to 0 of 0 employees",

                                lengthMenu:
                                    "Show _MENU_"

                            },


                            /* -----------------------------
                               COLUMN SETTINGS
                               ----------------------------- */

                            columnDefs: [

                                {
                                    /*
                                     * Action column
                                     */

                                    targets: 4,

                                    orderable: false,

                                    searchable: false
                                },

                                {
                                    /*
                                     * Status column
                                     *
                                     * It remains searchable
                                     * because the filter uses it.
                                     */

                                    targets: 5,

                                    orderable: false,

                                    searchable: true
                                }

                            ],


                            /* -----------------------------
                               DATATABLE LAYOUT
                               ----------------------------- */

                            layout: {

                                topStart: null,

                                topEnd: null,

                                bottomStart: [
                                    "pageLength",
                                    "info"
                                ],

                                bottomEnd: "paging"

                            }

                        }
                    );


                /* =================================================
                   CUSTOM SEARCH
                   ================================================= */

                const searchInput =
                    document.getElementById(
                        "employeeSearch"
                    );


                if (searchInput) {

                    searchInput.addEventListener(
                        "input",
                        function() {

                            employeeTable
                                .search(this.value)
                                .draw();

                        }
                    );

                }


                /* =================================================
                   STATUS FILTER
                   ================================================= */

                const statusFilter =
                    document.getElementById(
                        "statusFilter"
                    );


                if (statusFilter) {

                    statusFilter.addEventListener(
                        "change",
                        function() {

                            employeeTable
                                .column(5)
                                .search(this.value)
                                .draw();


                            updateFilterButton();

                        }
                    );

                }


                /* =================================================
                   CLEAR FILTER
                   ================================================= */

                const clearFilter =
                    document.getElementById(
                        "clearFilter"
                    );


                if (clearFilter) {

                    clearFilter.addEventListener(
                        "click",
                        function() {

                            statusFilter.value = "";


                            employeeTable
                                .column(5)
                                .search("")
                                .draw();


                            updateFilterButton();

                        }
                    );

                }


                /* =================================================
                   FILTER PANEL
                   ================================================= */

                const filterButton =
                    document.getElementById(
                        "filterButton"
                    );


                const filterPanel =
                    document.getElementById(
                        "filterPanel"
                    );


                if (filterButton && filterPanel) {

                    filterButton.addEventListener(
                        "click",
                        function(event) {

                            event.stopPropagation();


                            filterPanel.classList.toggle(
                                "show"
                            );


                            filterButton.classList.toggle(
                                "active"
                            );

                        }
                    );


                    filterPanel.addEventListener(
                        "click",
                        function(event) {

                            event.stopPropagation();

                        }
                    );


                    document.addEventListener(
                        "click",
                        function() {

                            filterPanel.classList.remove(
                                "show"
                            );


                            filterButton.classList.remove(
                                "active"
                            );

                        }
                    );

                }


                /* =================================================
                   FILTER BUTTON STATE
                   ================================================= */

                function updateFilterButton() {

                    if (
                        statusFilter &&
                        statusFilter.value !== ""
                    ) {

                        filterButton.classList.add(
                            "active"
                        );

                    }
                    else {

                        filterButton.classList.remove(
                            "active"
                        );

                    }

                }


                /* =================================================
                   SORT DROPDOWN
                   ================================================= */

                const sortEmployees =
                    document.getElementById(
                        "sortEmployees"
                    );


                if (sortEmployees) {

                    sortEmployees.addEventListener(
                        "change",
                        function() {

                            const value =
                                this.value.split("-");


                            const column =
                                parseInt(value[0]);


                            const direction =
                                value[1];


                            employeeTable
                                .order([
                                    [
                                        column,
                                        direction
                                    ]
                                ])
                                .draw();

                        }
                    );

                }


                /* =================================================
                   PAGE LENGTH
                   ================================================= */

                /*
                 * DataTables itself renders the page-length
                 * selector through layout: "pageLength".
                 *
                 * No custom pagination logic is needed.
                 */

            }
        );

    </script>
}