@page "{id:int}"
@model TaskTracker.Pages.Employees.EditRoleModel
@{
    ViewData["Title"] = "Change Employee Role";
}
<html>  
    <head>

    </head>
    <body>
        <h1>Change Role</h1>
        <p>Employee: <strong>@Model.EmployeeName</strong></p>

        <div class="row">
            <div class="col-md-6">
                <from method="post">
                <input type="hidden" asp-for="Input.EmployeeId" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="Input.NewRoleName" class="form-label"></label>
                    <select asp-for="Input.NewRoleName" asp-items="Model.RoleOptions" class="form-select">
                        <option value="">-- Select a Role --</option>
                    </select>
                    <span asp-validation-for="Input.NewRoleName" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Update Role</button>
                <a asp-page="/Employees/Details" asp-route-id="@Model.Input.EmployeeId" class="btn btn-secondary">Cancel</a>
                </from>
            </div>
        </div>
        @section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
    </body>
</html>