@if (User.IsInRole(AppRoles.Admin))
{
    <div class="dashboard-page">

        <!-- ========================================= -->
        <!-- HEADER -->
        <!-- ========================================= -->

        <div class="dashboard-header">

            <div>
                <h1>Admin Dashboard</h1>
                <p>Overview of your TaskTracker system</p>
            </div>

