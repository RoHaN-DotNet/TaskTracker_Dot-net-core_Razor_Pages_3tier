@page
@model TaskTracker.Pages.ProjectTasks.DetailsModel
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@{
    var priorityClass = Model.Task.Priority switch
    {
        TaskTrackerDAL.Models.Enums.TaskPriority.High => "bg-danger",
        TaskTrackerDAL.Models.Enums.TaskPriority.Medium => "bg-warning text-dark",
        TaskTrackerDAL.Models.Enums.TaskPriority.Low => "bg-success",
        _ => "bg-secondary"
    };

    var statusClass = Model.Task.Status switch
    {
        TaskTrackerDAL.Models.Enums.ProjectTasksStatus.Completed => "bg-success",
        TaskTrackerDAL.Models.Enums.ProjectTasksStatus.InProgress => "bg-primary",
        TaskTrackerDAL.Models.Enums.ProjectTasksStatus.OnHold => "bg-warning text-dark",
        TaskTrackerDAL.Models.Enums.ProjectTasksStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="container-fluid py-4 mt-lg-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <!--<a asp-page="/ProjectTasks/Tasks"
               class="text-decoration-none text-muted small">
                <i class="bi bi-arrow-left"></i> Back to Tasks
            </a>-->
            

            <h2 class="fw-bold mt-2 mb-1">
                @Model.Task.Title
            </h2>

            <!--<span class="text-muted">
                Task #@Model.Task.Id
            </span>-->
        </div>
        <!--
        <div class="d-flex gap-2">

            <span class="badge @statusClass px-3 py-2">
                @Model.Task.Status
            </span>

            <span class="badge @priorityClass px-3 py-2">
                @Model.Task.Priority
            </span>

        </div>
        -->
    </div>


    @if (TempData["TaskActionError"] is string actionError)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @actionError

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }


    <div class="row g-4">

        <!-- LEFT SIDE -->
        <div class="col-lg-8">

            <!-- Task Information -->
            <div class="card border-0 rounded-4 mb-4 task-detail-card">

                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        Task Details
                    </h5>
                </div>

                <div class="card-body px-4">

                    <!-- Project -->
                    <div class="mb-4">

                        <label class="text-muted small fw-semibold">
                            PROJECT
                        </label>

                        <div class="mt-1">
                            <span class="fw-semibold">
                                <i class="bi bi-folder me-2 text-primary"></i>
                                @Model.Task.ProjectName
                            </span>
                        </div>

                    </div>


                    <!-- Description -->
                    <div class="mb-4">

                        <label class="text-muted small fw-semibold">
                            DESCRIPTION
                        </label>

                        <div class="mt-2 p-3 bg-light rounded-3">
                            @if (string.IsNullOrWhiteSpace(Model.Task.Description))
                            {
                                <span class="text-muted">
                                    No description provided.
                                </span>
                            }
                            else
                            {
                                @Model.Task.Description
                            }
                        </div>

                    </div>


                    <!-- Due Date -->
                    <!--
                    <div class="mb-3">

                        <label class="text-muted small fw-semibold">
                            DUE DATE
                        </label>

                        <div class="mt-1">

                            @if (Model.Task.DueDate.HasValue)
                            {
                                <span class="fw-semibold">
                                    <i class="bi bi-calendar-event me-2"></i>
                                    @Model.Task.DueDate.Value.ToString("dd MMM yyyy")
                                </span>

                                @if (Model.Task.IsOverdue)
                                {
                                    <span class="badge bg-danger ms-2">
                                        Overdue
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">
                                    No deadline
                                </span>
                            }

                        </div>
                        

                    </div>
                    -->
                </div>

            </div>


            <!-- Progress Log -->
            <div class="card border-0 rounded-4 task-detail-card">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-chat-left-text me-2"></i>
                            Progress Log
                            <span class="badge bg-light text-dark">
                                @Model.ProgressNotes.Count note(s)
                            </span>
                        </h5>

                        
                        <button type="button"
                                class="btn btn-sm btn-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#addNoteModal">

                            <i class="bi bi-plus-lg me-1"></i>
                            Add Note

                        </button>
                    </div>

                </div>

                <div class="notes-scroll">
                    <div class="card-body px-4 pb-4">

                        @if (Model.ProgressNotes.Count == 0)
                        {
                            <div class="text-center py-5">

                                <i class="bi bi-chat-square-text fs-1 text-muted"></i>

                                <p class="text-muted mt-3 mb-0">
                                    No progress notes yet.
                                </p>

                            </div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">

                                @foreach (var note in Model.ProgressNotes)
                                {
                                    <div class="list-group-item px-0 py-3 border-bottom
                                        @(note.IsCompletionComment ? "bg-success bg-opacity-10" : "")">

                                        <div class="d-flex justify-content-between align-items-start">

                                            <div>

                                                <strong>
                                                    @note.AuthorName
                                                </strong>

                                                @if (note.IsCompletionComment)
                                                {
                                                    <span class="badge bg-success ms-2">
                                                        Completion
                                                    </span>
                                                }

                                            </div>

                                            <small class="text-muted">
                                                @note.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                                            </small>

                                        </div>

                                        <p class="mb-0 mt-2 text-secondary">
                                            @note.Note
                                        </p>

                                    </div>
                                }

                            </div>
                        }

                    </div>
                </div>
                
                
                
            </div>

        </div>


        <!-- RIGHT SIDE -->
        <div class="col-lg-4">

            <!-- Task Summary -->
            <div class="card border-0 rounded-4 mb-4 task-detail-card">

                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0">
                        Task Summary
                    </h5>
                </div>

                <div class="card-body px-4">

                    <!-- Assigned To -->
                    <div class="d-flex align-items-center mb-4">

                        <div class="rounded-circle bg-primary bg-opacity-10
                            text-primary d-flex align-items-center
                            justify-content-center me-3"
                             style="width:45px;height:45px;">

                            <i class="bi bi-person"></i>

                        </div>

                        <div>
                            <small class="text-muted d-block">
                                Assigned To
                            </small>

                            <strong>
                                @(Model.Task.AssignedToUserName ?? "Unassigned")
                            </strong>
                        </div>

                    </div>


                    <!-- Priority -->
                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Priority
                        </span>

                        <span class="badge @priorityClass">
                            @Model.Task.Priority
                        </span>

                    </div>


                    <!-- Status -->
                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Status
                        </span>

                        <span class="badge @statusClass">
                            @Model.Task.Status
                        </span>

                    </div>


                    <!-- Deadline -->
                    <div class="d-flex justify-content-between">

                        <span class="text-muted">
                            Deadline
                        </span>

                        <strong>
                            @(Model.Task.DueDate?.ToString("dd MMM yyyy") ?? "None")
                        </strong>

                    </div>

                </div>

            </div>
            <!--Files-->
            
            <div class="card border-0 mt-4 task-detail-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-paperclip me-1"></i>
                        Attachments
                        <span class="badge bg-light text-dark">
                            @Model.TaskFiles.Count files(s)
                        </span>
                    </h5>

                        
                    <button type="button"
                            class="btn btn-sm btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#addFilesModal">
                        <i class="bi bi-plus-lg me-1"></i>
                        Add File
                    </button>
                </div>
             <div class="files-scroll">
                <div class="card-body">
                    
                    @if (Model.TaskFiles.Any())
                    {
                        <div class="list-group">

                            @foreach (var file in Model.TaskFiles)
                            {
                                
                                <div class="list-group-item d-flex justify-content-between align-items-center">

                                    <div class="d-flex align-items-center gap-3">

                                        <i class="bi bi-file-earmark fs-4"></i>

                                        <div>
                                            <div class="fw-semibold">
                                                @file.FileName
                                            </div>

                                            <small class="text-muted">
                                                @file.UploadedAt.ToString("dd MMM yyyy, hh:mm tt")
                                            </small>
                                        </div>

                                    </div>

                                    <a href="@file.FilePath"
                                       target="_blank"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-download me-1"></i>
                                        Download
                                    </a>

                                </div>
                               
                            }

                        </div>
                    }
                    else
                    {
                        <div class="text-muted text-center py-3">
                            <i class="bi bi-paperclip fs-4 d-block mb-2"></i>
                            No files attached to this task.
                        </div>
                    }

                </div>
             </div>
            </div>
            <!-- Management Actions -->
            @if (Model.CanManage)
            {
                <div class="card border-0 rounded-4 task-detail-card">

                    <div class="card-header bg-white border-0 pt-4 px-4">
                        <h5 class="fw-bold mb-0">
                            Manage Task
                        </h5>
                    </div>

                    <div class="card-body px-4 pb-4">

                        <div class="d-grid gap-2">

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#changeDeadlineModal">
                                <i class="bi bi-calendar-event me-2"></i>
                                Change Deadline
                            </button>


                            <a asp-page="/Tasks/ChangePriority"
                               asp-route-id="@Model.Task.Id"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-flag me-2"></i>
                                Change Priority

                            </a>


                            @if (Model.Task.AssignedToUserId.HasValue)
                            {
                                <a asp-page="/Tasks/Reassign"
                                   asp-route-id="@Model.Task.Id"
                                   class="btn btn-outline-secondary">

                                    <i class="bi bi-person-gear me-2"></i>
                                    Reassign

                                </a>
                            }
                            else
                            {
                                <a asp-page="/Tasks/Assign"
                                   asp-route-id="@Model.Task.Id"
                                   class="btn btn-outline-primary">

                                    <i class="bi bi-person-plus me-2"></i>
                                    Assign Task

                                </a>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>

</div>
<!-- Change Deadline Modal -->
<div class="modal fade" id="changeDeadlineModal" tabindex="-1" aria-labelledby="changeDeadlineModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-sm rounded-4">
            <div class="modal-header border-0 px-4 pt-4">
                <div>
                    <h5 class="modal-title fw-bold" id="changeDeadlineModalLabel">
                        Change Deadline
                    </h5>
                    <small class="text-muted">
                        @Model.Task.Title
                    </small>
                </div>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>
            <form method="post" asp-page-handler="ChangeDeadline">
                <div asp-validation-summary="ModelOnly" class="text-danger px-4"></div>

                <div class="modal-body px-4">
                    <input type="hidden" name="Input.TaskId" value="@Model.Task.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">New Deadline</label>
                        <input type="date"
                               name="Input.NewDueDate"
                               class="form-control"
                               value="@(Model.Task.DueDate?.ToString("yyyy-MM-dd"))"
                               required />
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Save Deadline
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
<!--Add Files Modal-->
<div class="modal fade" id="addFilesModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h4>Add File</h4>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post"
      asp-page-handler="AddFiles"
      enctype="multipart/form-data">

    <div class="modal-body">

        <div class="mt-3">

            <input type="hidden"
                   name="id"
                   value="@Model.Task.Id" />

            <label class="form-label fw-bold">
                Attach File
            </label>

            <input type="file"
                   asp-for="UploadFile"
                   class="form-control"
                   required />

            <small class="text-muted">
                Select a file to attach to this task.
            </small>

        </div>

    </div>

    <div class="modal-footer">

        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit"
                class="btn btn-primary">
            Add File
        </button>

    </div>

</form>
            
        </div>

    </div>
</div>
<!-- Add Note Modal -->
<div class="modal fade" id="addNoteModal" tabindex="-1" aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    <i class="bi bi-chat-left-text me-2"></i>
                    Add Progress Note
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form method="post"
                  asp-page-handler="AddNote">

                <div class="modal-body">

                    <!-- Task ID -->
                    <input type="hidden"
                           name="NoteInput.TaskId"
                           value="@Model.Task.Id" />

                    <div class="mb-3">

                        <label class="form-label fw-bold">
                            Note
                        </label>

                        <textarea name="NoteInput.Note"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Write your progress note..."
                                  required></textarea>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1"></i>
                        Add Note
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>