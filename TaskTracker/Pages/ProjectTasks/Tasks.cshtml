@page
@model TaskTracker.Pages.ProjectTasks.TasksModel
@{
}

<form id="antiForgeryForm" method="post">
    @Html.AntiForgeryToken()
</form>
@using TaskTrackerDAL.Models.Enums
@using TaskTrackerDAL.Constants

@{
    ViewData["Title"] = "Tasks";

    ViewData["ViewableTaskIds"] = Model.ViewableTaskIds;
}
<!-- =========================
     Toast Notification
========================= -->

<div class="toast-container position-fixed top-0 end-0 p-3"
     style="z-index: 9999;">

    <div id="appToast"
         class="toast border-0 shadow-lg"
         role="alert"
         aria-live="assertive"
         aria-atomic="true">

        <div class="toast-header border-0">
            <div id="toastIcon"
                 class="me-2">
            </div>

            <strong id="toastTitle" class="me-auto">
                Notification
            </strong>

            <small class="text-muted">
                Now
            </small>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="toast"
                    aria-label="Close">
            </button>
        </div>

        <div id="toastMessage"
             class="toast-body">
        </div>

    </div>

</div>
<div class="container-fluid mt-0">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-2">

        <!-- Left: Title -->
        <div>
            <h2 class="fw-bold mb-0">Task Board</h2>

            <small class="text-muted">
                Drag tasks between columns
            </small>
        </div>
        <!-- Right: Actions -->
        <div class="d-flex align-items-center gap-3">
            <!-- Employee: Task Toggle -->
            @if (Model.IsEmployee)
            {
                <div class="task-filter-toggle">

                    <!-- Dynamic Label -->
                    <span id="taskViewLabel"
                          class="task-view-label">

                        @(Model.ShowMyTasks
                            ? "My Tasks"
                            : "All Tasks")
                    </span>
                    <!-- Toggle -->
                    <div class="form-check form-switch mb-0">

                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               id="myTasksToggle"
                        @(Model.ShowMyTasks ? "checked" : "") />

                    </div>

                </div>
            }


            <!-- Manager: Create Task -->
            @if (Model.IsManager)
            {
                <button type="button"
                        class="project-add-button"
                        data-bs-toggle="modal"
                        data-bs-target="#createTaskModal">

                    <i class="bi bi-plus-circle"></i>
                    Add

                </button>
            }

        </div>

    </div>
    <!--Filter Remaining-->
    <div>

    </div>
    <!--Kanbar Board-->
    <div class="row g-3 justify-content-around">
        <!-- NOT STARTED -->
        <div class="col-lg-2" style="width:250px;">
            <div class="kanban-column">
                <div class="kanban-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <span class="status-dot"></span>
                            <h5 class="ms-2 mb-0">
                                Not Started
                            </h5>
                        </div>
                        <span class="task-count">
                            @Model.NotStartedTasks.Count
                        </span>
                    </div>
                </div>
                <div class="kanban-body"
                     id="NotStarted"
                     data-status="@((int)ProjectTasksStatus.NotStarted)">
                    @foreach (var task in Model.NotStartedTasks)
                    {
                        <partial name="_TaskCard" model="task" />
                    }
                </div>
            </div>
        </div>
        @if (Model.IsManager || Model.IsEmployee)
        {
            <!--In Progress-->
            <div class="col-lg-2" style="width:250px;">
                <div class="kanban-column">
                    <div class="kanban-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <span class="status-dot"></span>
                                <h5 class="ms-2 mb-0">
                                    In Progress
                                </h5>
                            </div>
                            <span class="task-count">
                                @Model.InProgressTasks.Count
                            </span>
                        </div>
                    </div>
                    <div class="kanban-body"
                    id="InProgress"
                    data-status="@((int)ProjectTasksStatus.InProgress)">
                        @foreach (var task in Model.InProgressTasks)
                        {
                            <partial name="_TaskCard" model="task" />
                        }
                    </div>
                </div>
            </div>
            <!--On Hold-->
            <div class="col-lg-2" style="width:250px;">
                <div class="kanban-column">
                    <div class="kanban-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <span class="status-dot"></span>
                                <h5 class="ms-2 mb-0">
                                    On Hold
                                </h5>
                            </div>
                            <span class="task-count">
                                @Model.OnHoldTasks.Count
                            </span>
                        </div>
                    </div>
                    <div class="kanban-body"
                    id="OnHold"
                    data-status="@((int)ProjectTasksStatus.OnHold)">
                        @foreach (var task in Model.OnHoldTasks)
                        {
                            <partial name="_TaskCard" model="task" />
                        }
                    </div>
                </div>
            </div>
            <!--Completed-->
            <div class="col-lg-2" style="width:250px;">
                <div class="kanban-column">
                    <div class="kanban-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <span class="status-dot"></span>
                                <h5 class="ms-2 mb-0">
                                    Completed
                                </h5>
                            </div>
                            <span class="task-count">
                                @Model.CompletedTasks.Count
                            </span>
                        </div>
                    </div>
                    <div class="kanban-body"
                    id="Completed"
                    data-status="@((int)ProjectTasksStatus.Completed)">
                        @foreach (var task in Model.CompletedTasks)
                        {
                            <partial name="_TaskCard" model="task" />
                        }
                    </div>
                </div>
            </div>
            <!--Cancelled-->
            <div class="col-lg-2" style="width:250px;">
                <div class="kanban-column">
                    <div class="kanban-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <span class="status-dot"></span>
                                <h5 class="ms-2 mb-0">
                                    Cancelled
                                </h5>
                            </div>
                            <span class="task-count">
                                @Model.CancelledTasks.Count
                            </span>
                        </div>
                    </div>
                    <div class="kanban-body"
                         id="Cancelled"
                         data-status="@((int)ProjectTasksStatus.Cancelled)">
                        @foreach (var task in Model.CancelledTasks)
                        {
                            <partial name="_TaskCard" model="task" />
                        }
                    </div>
                </div>
            </div>
            @if (Model.IsManager)
            {
                <!--Archived-->
                <div class="" style="width:250px;">
                    <div class="kanban-column">
                        <div class="kanban-header">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center">
                                    <span class="status-dot"></span>
                                    <h5 class="ms-2 mb-0">
                                        Archived
                                    </h5>
                                </div>
                                <span class="task-count">
                                    @Model.ArchivedTasks.Count
                                </span>
                            </div>
                        </div>
                        <div class="kanban-body"
                             id="Archived"
                             data-status="@((int)ProjectTasksStatus.Archived)">
                            @foreach (var task in Model.ArchivedTasks)
                            {
                                <partial name="_TaskCard" model="task" />
                            }
                        </div>
                    </div>
                </div>
            }
        }
        <!---->
    </div>
</div>
<!--Create Task Modal-->
<div class="modal fade" id="createTaskModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h4>Create Task</h4>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
