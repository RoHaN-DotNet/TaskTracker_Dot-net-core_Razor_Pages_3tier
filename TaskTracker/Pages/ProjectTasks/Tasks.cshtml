                    <div>
                        <input asp-for="createTask.Priority" type="hidden" />
                    </div>
                    <div class="mt-3">
                        
    <label class="form-label fw-bold">Assign To</label>

    <div id="projectMembersContainer"
         class="border rounded-3 p-3"
         style="max-height:200px; overflow-y:auto;">

        <div class="text-muted">
            Please select a project first.
        </div>

    </div>
</div>

                       
                    
                </div>
            
                <div class="modal-footer">
                    <button class="btn-cancel" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn-save" type="submit">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Hidden form — shudhu anti-forgery token pawar jonno -->
<form id="antiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>
@section Scripts
{
    <script>

        let draggedCard = null;

        // =========================================================
        // TOAST NOTIFICATION
        // =========================================================

        function createToastContainer() {

            // Already exists
            if (document.getElementById("appToast")) {
                return;
            }

            // Add CSS
            if (!document.getElementById("appToastStyle")) {

                const style = document.createElement("style");

                style.id = "appToastStyle";

                style.innerHTML = `

                            #appToast {
                                min-width: 340px;
                                max-width: 420px;
                                border-radius: 14px;
                                overflow: hidden;
                            }

                            #appToast .toast-header {
                                padding: 12px 15px;
                                background: white;
                            }

                            #appToast .toast-body {
                                padding: 12px 15px 15px;
                                font-size: 14px;
                                font-weight: 500;
                                background: white;
                            }

                            #toastIcon {
                                width: 30px;
                                height: 30px;
                                border-radius: 50%;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                            }

                            #appToast.toast-success {
                                border-left: 5px solid #198754 !important;
                            }

                            #appToast.toast-success #toastIcon {
                                background-color: rgba(25, 135, 84, 0.12);
                                color: #198754;
                            }

                            #appToast.toast-error {
                                border-left: 5px solid #dc3545 !important;
                            }

                            #appToast.toast-error #toastIcon {
                                background-color: rgba(220, 53, 69, 0.12);
                                color: #dc3545;
                            }

                            #appToast.toast-warning {
                                border-left: 5px solid #ffc107 !important;
                            }

                            #appToast.toast-warning #toastIcon {
                                background-color: rgba(255, 193, 7, 0.15);
                                color: #856404;
                            }

                            #appToast.toast-info {
                                border-left: 5px solid #0d6efd !important;
                            }

                            #appToast.toast-info #toastIcon {
                                background-color: rgba(13, 110, 253, 0.12);
                                color: #0d6efd;
                            }

                        `;

                document.head.appendChild(style);
            }


            // Add Toast HTML

            const container = document.createElement("div");

            container.className =
                "toast-container position-fixed top-0 end-0 p-3";

            container.style.zIndex = "9999";

            container.innerHTML = `

                        <div id="appToast"
                             class="toast border-0 shadow-lg"
                             role="alert"
                             aria-live="assertive"
                             aria-atomic="true">

                            <div class="toast-header border-0">

                                <div id="toastIcon" class="me-2">
                                </div>

                                <strong id="toastTitle" class="me-auto">
                                    Notification
                                </strong>

                                <small class="text-muted">
                                    Now
                                </small>

                                <button type="button"
                                        class="btn-close"
                                        data-bs-dismiss="toast"
                                        aria-label="Close">
                                </button>

                            </div>

                            <div id="toastMessage"
                                 class="toast-body">
                            </div>

                        </div>

                    `;

            document.body.appendChild(container);
        }


        function showToast(message, type = "success", title = null) {

            createToastContainer();


            const toastElement =
                document.getElementById("appToast");

            const toastMessage =
                document.getElementById("toastMessage");

            const toastTitle =
                document.getElementById("toastTitle");

            const toastIcon =
                document.getElementById("toastIcon");


            // Remove old classes

            toastElement.classList.remove(
                "toast-success",
                "toast-error",
                "toast-warning",
                "toast-info"
            );


            // Add current type

            toastElement.classList.add(
                "toast-" + type
            );


            // Message

            toastMessage.textContent =
                message || "Something happened.";


            // Title

            if (!title) {

                if (type === "success") {
                    title = "Success";
                }
                else if (type === "error") {
                    title = "Error";
                }
                else if (type === "warning") {
                    title = "Warning";
                }
                else {
                    title = "Information";
                }
            }


            toastTitle.textContent = title;


            // Icon

            if (type === "success") {

                toastIcon.innerHTML =
                    '<i class="bi bi-check-lg"></i>';

            }
            else if (type === "error") {

                toastIcon.innerHTML =
                    '<i class="bi bi-x-lg"></i>';

            }
            else if (type === "warning") {

                toastIcon.innerHTML =
                    '<i class="bi bi-exclamation-lg"></i>';

            }
            else {

                toastIcon.innerHTML =
                    '<i class="bi bi-info-lg"></i>';
            }


            // Bootstrap Toast

            const toast =
                bootstrap.Toast.getOrCreateInstance(
                    toastElement,
                    {
                        delay: 3500
                    }
                );

            toast.show();
        }



        // =========================================================
        // GET ANTI FORGERY TOKEN
        // =========================================================

        function getAntiForgeryToken() {

            const token =
                document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                );

            return token ? token.value : "";
        }



        // =========================================================
        // DRAG & DROP
        // =========================================================

        function initializeDragAndDrop() {

            // -----------------------------------------------------
            // TASK CARDS
            // -----------------------------------------------------

            const taskCards =
                document.querySelectorAll(".task-card");


            taskCards.forEach(card => {

                // Prevent duplicate listeners
                if (card.dataset.dragInitialized === "true") {
                    return;
                }

                card.dataset.dragInitialized = "true";


                // Make draggable

                card.setAttribute(
                    "draggable",
                    "true"
                );


                // -------------------------------------------------
                // DRAG START
                // -------------------------------------------------

                card.addEventListener(
                    "dragstart",
                    function(e) {

                        // ---------------------------------------------
                        // DO NOT START DRAG FROM ACTION BUTTONS
                        // ---------------------------------------------

                        if (
                            e.target.closest(".task-actions") ||
                            e.target.closest(".comment-box") ||
                            e.target.closest("button") ||
                            e.target.closest("a") ||
                            e.target.closest("input") ||
                            e.target.closest("textarea") ||
                            e.target.closest("select")
                        ) {

                            e.preventDefault();

                            return;

                        }


                        draggedCard = this;


                        const taskId =
                            this.dataset.id;


                        e.dataTransfer.effectAllowed =
                            "move";


                        e.dataTransfer.setData(
                            "text/plain",
                            taskId
                        );


                        e.dataTransfer.setData(
                            "taskId",
                            taskId
                        );


                        setTimeout(() => {

                            this.classList.add(
                                "dragging"
                            );

                        }, 0);

                    }
                );


                // -------------------------------------------------
                // DRAG END
                // -------------------------------------------------

                card.addEventListener(
                    "dragend",
                    function() {

                        this.classList.remove(
                            "dragging"
                        );

                        draggedCard = null;


                        // Remove drag-over from all columns

                        document
                            .querySelectorAll(".kanban-body")
                            .forEach(column => {

                                column.classList.remove(
                                    "drag-over"
                                );

                            });

                    }
                );

            });



            // -----------------------------------------------------
            // KANBAN COLUMNS
            // -----------------------------------------------------

            const columns =
                document.querySelectorAll(
                    ".kanban-body"
                );


            columns.forEach(column => {

                if (
                    column.dataset.dropInitialized === "true"
                ) {
                    return;
                }

                column.dataset.dropInitialized = "true";


                // -------------------------------------------------
                // DRAG OVER
                // -------------------------------------------------

                column.addEventListener(
                    "dragover",
                    function(e) {

                        e.preventDefault();

                        e.dataTransfer.dropEffect =
                            "move";

                        this.classList.add(
                            "drag-over"
                        );

                    }
                );


                // -------------------------------------------------
                // DRAG LEAVE
                // -------------------------------------------------

                column.addEventListener(
                    "dragleave",
                    function(e) {

                        // Only remove when actually leaving column

                        if (
                            e.relatedTarget &&
                            this.contains(e.relatedTarget)
                        ) {
                            return;
                        }

                        this.classList.remove(
                            "drag-over"
                        );

                    }
                );


                // -------------------------------------------------
                // DROP
                // -------------------------------------------------

                column.addEventListener(
                    "drop",
                    async function(e) {

                        e.preventDefault();


                        this.classList.remove(
                            "drag-over"
                        );


                        // Get task ID

                        let taskId =
                            e.dataTransfer.getData(
                                "text/plain"
                            );


                        if (!taskId) {

                            taskId =
                                e.dataTransfer.getData(
                                    "taskId"
                                );

                        }


                        // Validate task ID

                        if (!taskId) {

                            showToast(
                                "Unable to identify the task.",
                                "error",
                                "Update Failed"
                            );

                            return;
                        }


                        taskId =
                            parseInt(taskId);


                        // Get new status

                        const newStatus =
                            parseInt(
                                this.dataset.status
                            );


                        if (isNaN(taskId) ||
                            isNaN(newStatus)) {

                            showToast(
                                "Invalid task or status.",
                                "error",
                                "Update Failed"
                            );

                            return;
                        }


                        // Token

                        const token =
                            getAntiForgeryToken();


                        try {

                            const response =
                                await fetch(
                                    "?handler=UpdateTaskStatus",
                                    {
                                        method: "POST",

                                        headers: {

                                            "Content-Type":
                                                "application/json",

                                            "RequestVerificationToken":
                                                token

                                        },

                                        body: JSON.stringify({

                                            taskId: taskId,

                                            newStatus: newStatus

                                        })
                                    }
                                );


                            // -------------------------------------
                            // RESPONSE
                            // -------------------------------------

                            let result;


                            try {

                                result =
                                    await response.json();

                            }
                            catch {

                                result = {

                                    success: false,

                                    message:
                                        "Invalid server response."

                                };

                            }


                            // -------------------------------------
                            // SUCCESS
                            // -------------------------------------

                            if (
                                response.ok &&
                                result.success
                            ) {

                                showToast(

                                    result.message ||
                                    "Task status updated successfully.",

                                    "success",

                                    "Status Updated"

                                );


                                // Reload after toast

                                setTimeout(
                                    () => {

                                        window.location.reload();

                                    },
                                    1000
                                );

                        }

                            // -------------------------------------
                            // SERVER ERROR / PERMISSION ERROR
                            // -------------------------------------
                            else {
                                showToast(
                                   result.message ||
                                    "You are not allowed to update this task.",
                                    "warning",
                                    "Action Not Allowed"
                                );
                            }
                        }
                        catch (error) {
                            console.error(
                                "UpdateTaskStatus Error:",
                                error
                            );
                            showToast(
                                "Something went wrong while updating the task.",
                                "error",
                                "Server Error"
                            );
                        }
                    }
                );
            });
        }
        // ================= CREATE TASK =================
        function initializeCreateTask() {

            const createForm = document.querySelector("#createTaskModal form");

            if (!createForm) {
                return;
            }

            if (createForm.dataset.initialized === "true") {
                return;
            }

            createForm.dataset.initialized = "true";

            createForm.addEventListener("submit", async function(e) {
                e.preventDefault();

                const form = this;
                const formData = new FormData(form);
                const token = getAntiForgeryToken();

                const submitButton = form.querySelector('button[type="submit"]');
                const originalText = submitButton ? submitButton.innerHTML : "Create";

                if (submitButton) {
                    submitButton.disabled = true;
                    submitButton.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> Creating...`;
                }

                try {
                    const response = await fetch("?handler=CreateTask", {
                        method: "POST",
                        body: formData,
                        headers: { "RequestVerificationToken": token }
                    });

                    const responseText = await response.text();
                    let result = null;

                    try {
                        result = JSON.parse(responseText);
                    } catch {
                        result = null;
                    }

                    if (response.ok && (result === null || result.success !== false)) {
                        const modalElement = document.getElementById("createTaskModal");
                        if (modalElement) {
                            const modal = bootstrap.Modal.getInstance(modalElement);
                            if (modal) {
                                modal.hide();
                            }
                        }

                        showToast(result?.message || "Task created successfully.", "success", "Task Created");

                        setTimeout(() => {
                            window.location.reload();
                        }, 1000);
                    }
                    else {
                        showToast(result?.message || "Unable to create task.", "error", "Create Failed");
                    }
                }
                catch (error) {
                    console.error("CreateTask Error:", error);
                    showToast("Something went wrong while creating the task.", "error", "Create Failed");
                }
                finally {
                    if (submitButton) {
                        submitButton.disabled = false;
                        submitButton.innerHTML = originalText;
                    }
                }
            });

        } // ← EIKHANE initializeCreateTask() SHESH — brace ekhon thik jaygay


        // ================= COMMENT BOX ================= (EKHON GLOBAL/TOP-LEVEL FUNCTION)
        function initializeComments() {

            document.addEventListener("click", function(event) {

                // =========================================
                // COMMENT BUTTON
                // =========================================

                const commentButton =
                    event.target.closest(".add-note-toggle");

                if (commentButton) {

                    event.preventDefault();
                    event.stopPropagation();

                    const taskId =
                        commentButton.getAttribute("data-task-id");

                    const currentBox =
                        document.getElementById(
                            "comment-box-" + taskId
                        );

                    if (!currentBox) {
                        console.error(
                            "Comment box not found for task:",
                            taskId
                        );
                        return;
                    }


                    // Close all other comment boxes
                    document
                        .querySelectorAll(".comment-box.show")
                        .forEach(function(box) {

                            if (box !== currentBox) {
                                box.classList.remove("show");
                            }

                        });


                    // Toggle current comment box
                    currentBox.classList.toggle("show");


                    // Focus textarea
                    if (currentBox.classList.contains("show")) {

                        const textarea =
                            currentBox.querySelector(".comment-text");

                        if (textarea) {

                            setTimeout(function() {
                                textarea.focus();
                            }, 300);

                        }

                    }

                    return;
                }


                // =========================================
                // CANCEL BUTTON
                // =========================================

                const cancelButton =
                    event.target.closest(".comment-cancel");

                if (cancelButton) {

                    event.preventDefault();
                    event.stopPropagation();

                    const currentBox =
                        cancelButton.closest(".comment-box");

                    if (!currentBox) {
                        return;
                    }


                    // Clear textarea
                    const textarea =
                        currentBox.querySelector(".comment-text");

                    if (textarea) {
                        textarea.value = "";
                    }


                    // Hide comment box
                    currentBox.classList.remove("show");

                }

            });

        }


        // ================= MY TASKS / ALL TASKS TOGGLE =================
        function initializeTaskToggle() {
            $(document).off("change", "#myTasksToggle");
            $(document).on("change", "#myTasksToggle", function() {
                if (this.checked) {
                    window.location.href = "?myTasks=true";
                } else {
                    window.location.href = "?myTasks=false";
                }
            });
        }


        // ================= PROJECT MEMBERS =================
        function initializeProjectMembers() {
            const projectSelect = document.getElementById("projectSelect");
            const membersContainer = document.getElementById("projectMembersContainer");

            if (!projectSelect || !membersContainer) {
                return;
            }

            if (projectSelect.dataset.initialized === "true") {
                return;
            }

            projectSelect.dataset.initialized = "true";

            projectSelect.addEventListener("change", async function() {
                const projectId = this.value;
                membersContainer.innerHTML = "";

                if (!projectId) {
                    membersContainer.innerHTML = `<div class="text-muted">Please select a project first.</div>`;
                    return;
                }

                membersContainer.innerHTML = `<div class="text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Loading members...</div>`;

                try {
                    const response = await fetch(`?handler=ProjectMembers&projectId=${projectId}`);

                    if (!response.ok) {
                        throw new Error("Failed to load project members.");
                    }

                    const members = await response.json();
                    membersContainer.innerHTML = "";

                    if (!members || members.length === 0) {
                        membersContainer.innerHTML = `<div class="text-muted">No members found in this project.</div>`;
                        return;
                    }

                    members.forEach(member => {
                        const div = document.createElement("div");
                        div.className = "form-check mb-2";

                        const roles = member.roles && member.roles.length > 0
                            ? member.roles.join(", ")
                            : "";

                        div.innerHTML = `
                                    <input class="form-check-input" type="checkbox"
                                           name="createTask.AssignedToUserIds"
                                           value="${member.id}" id="create_emp_${member.id}" />
                                    <label class="form-check-label" for="create_emp_${member.id}">
                                        <strong>${member.name}</strong>
                                        ${roles ? `<span class="text-secondary">[${roles}]</span>` : ""}
                                    </label>
                                `;

                        membersContainer.appendChild(div);
                    });
                }
                catch (error) {
                    console.error("ProjectMembers Error:", error);
                    membersContainer.innerHTML = `<div class="text-danger">Failed to load project members.</div>`;
                    showToast("Failed to load project members.", "error", "Loading Failed");
                }
            });
        }
        // ================= TASK CARD CLICK =================

function initializeTaskCardClick() {

    document.querySelectorAll(".task-card").forEach(card => {

        if (card.dataset.clickInitialized === "true") {
            return;
        }

        card.dataset.clickInitialized = "true";

        card.addEventListener("click", function (e) {

            // Action button / link / input থেকে click হলে
            // task details modal open হবে না

            if (
                e.target.closest(".task-actions") ||
                e.target.closest("button") ||
                e.target.closest("a") ||
                e.target.closest("input") ||
                e.target.closest("textarea") ||
                e.target.closest("select") ||
                e.target.closest(".comment-box")
            ) {
                return;
            }
                    // ----------------------------------------------------
                    // DETAILS PERMISSION
                    // ----------------------------------------------------

                    if (this.dataset.canViewDetails !== "true") {

                        showToast(
                            "You are not assigned to this task.",
                            "warning",
                            "Access Denied"
                        );

                        return;
                    }
            const modalId =
                this.getAttribute("data-bs-target");

            if (!modalId) {
                return;
            }

            const modalElement =
                document.querySelector(modalId);

            if (!modalElement) {
                return;
            }

            const modal =
                bootstrap.Modal.getOrCreateInstance(
                    modalElement
                );

            modal.show();
        });
    });
}
        // =========================================================
        // DETAILS ACCESS DENIED
        // =========================================================

        function initializeDetailsAccess() {

            document
                .querySelectorAll(".details-access-denied")
                .forEach(button => {

                    if (button.dataset.initialized === "true") {
                        return;
                    }

                    button.dataset.initialized = "true";

                    button.addEventListener("click", function(e) {

                        e.preventDefault();
                        e.stopPropagation();

                        showToast(
                            "You are not assigned to this task.",
                            "warning",
                            "Access Denied"
                        );
                    });
                });
        }

        // ================= PAGE INITIALIZATION =================
        document.addEventListener("DOMContentLoaded", function() {

            createToastContainer();

            initializeDragAndDrop();

            initializeCreateTask();

            initializeComments();

            initializeTaskToggle();

            initializeProjectMembers();

            initializeDetailsAccess();

            initializeTaskCardClick();
        });

    </script>
