@model TaskTrackerBLL.DTOs.Tasks.TaskDto
@using TaskTrackerDAL.Models.Enums

<div class="task-card card shadow-sm border-0 mb-3"
     draggable="true"
     data-id="@Model.Id">

    <div class="card-body">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-start mb-2">

            <h6 class="task-title mb-0">
                @Model.Title
            </h6>
            @switch (Model.Priority)
            {
                case TaskPriority.High:
                    <span class="priority-dot bg-danger"
                          title="High"></span>
                    break;

                case TaskPriority.Medium:
                    <span class="priority-dot bg-warning"
                          title="Medium"></span>
                    break;

                case TaskPriority.Low:
                    <span class="priority-dot bg-success"
                          title="Low"></span>
                    break;
                case TaskPriority.Critical:
                    <span class="priority-dot bg-dark-subtle"
                          title="Critical"></span>
                    break;
            }
            
        </div>

        <!-- Project -->
        <p class="project-name mb-2">
            @Model.ProjectName
        </p>

        <!-- Assigned User -->
        <p class="assigned-user mb-2">
            Assigned:
            <strong>
                @(string.IsNullOrWhiteSpace(Model.AssignedToUserName)
                    ? "Unassigned"
                    : Model.AssignedToUserName)
            </strong>
        </p>

        <!-- Due Date -->
        <div class="d-flex justify-content-between">
            <div class="due-date mb-3">

                @if (Model.DueDate.HasValue)
                {
                    @Model.DueDate.Value.ToString("dd MMM")
                }
                else
                {
                    <span>No Deadline</span>
                }
            </div>
            <div>

                <button type="button"
                        data-id="@Model.Id"
                        class="icon-btn add-note-toggle"
                        title="Add Comment">
                    <i class="bi bi-chat"></i>
                </button>
                <a asp-page="/ProjectTasks/Details"
                        asp-route-id="@Model.Id"
                        type="button"
                        class="icon-btn"
                        title="View Details">
                    <i class="bi bi-eye"></i>
                </a>

            </div>
         </div>
        <!-- Inline Comment Box (hidden by default, toggled by the chat icon) -->
        <div class="comment-box"
             id="comment-box-@Model.Id">
            <form method="post" asp-page-handler="AddNote">
                @Html.AntiForgeryToken()
                <input type="hidden" name="NoteInput.TaskId" value="@Model.Id" />
                <textarea name="NoteInput.Note"
                          class="form-control form-control-sm comment-text"
                          rows="2"
                          placeholder="Write a comment..."
                          required></textarea>
                <div class="d-flex justify-content-end mt-1 gap-2">
                    <button type="button"
                            class="btn btn-sm btn-light comment-cancel mb-1">
                        Cancel
                    </button>
                    <button type="submit"
                            class="btn btn-sm btn-primary mb-1">
                        Post
                    </button>
                </div>
            </form>
        </div>
        <!-- Bottom Buttons -->
    </div>
</div>

@section Scripts{
    <script>
        $(document).on("click", ".add-note", function () {

            const taskId = $(this).data("id");

            $("#TaskId").val(taskId);

            $("#addNoteModal").modal("show");
        });
    </script>
    
}