@page
@model TaskTracker.Pages.ProjectTasks.IndexModel

@using TaskTrackerDAL.Models.Enums

@{
    ViewData["Title"] = "Tasks";
}

<link rel="stylesheet" href="~/css/project.css" />
<link rel="stylesheet" href="~/css/tasks.css" />

<div class="tasks-page">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="project-page-header">

        @if (Model.IsAdmin || Model.IsManager)
        {
            <h2 class="project-page-title">Tasks</h2>
        }
        else
        {
            <h2 class="project-page-title">Tasks</h2>

            <p class="project-page-subtitle">
                You are assigned to
            </p>
        }

    </div>


    <!-- =========================================================
         TASK TABLE CARD
         ========================================================= -->

    <div class="project-table-card">

        <!-- =====================================================
             TOOLBAR
             ===================================================== -->
        @if (Model.IsManager || Model.IsAdmin)
        {
            <div class="project-toolbar">

                <!-- SEARCH -->
                <div class="project-search">

                    <i class="mdi mdi-magnify project-search-icon"></i>

                    <input type="search"
                           id="taskSearch"
                           autocomplete="off"
                           placeholder="Search tasks..." />

                </div>


                <!-- RIGHT SIDE -->
                <div class="project-toolbar-right">

                    <!-- FILTER -->
                    <div class="project-filter-wrapper">

                        <button type="button"
                                id="filterButton"
                                class="project-filter-button">

                            <i class="mdi mdi-filter-variant"></i>

                            <span>Filter</span>

                        </button>


                        <div id="filterPanel"
                             class="project-filter-panel">

                            <div class="project-filter-title">
                                Task Status
                            </div>


                            <select id="statusFilter"
                                    class="project-filter-select">

                                <option value="">
                                    All Tasks
                                </option>

                                @foreach (var status in Enum.GetValues<ProjectTasksStatus>())
                                {
                                    <option value="@status">
                                        @status
                                    </option>
                                }

                            </select>


                            <button type="button"
                                    id="clearFilter"
                                    class="project-filter-clear">

                                Clear filter

                            </button>

                        </div>

                    </div>


                    <!-- SORT -->
                    <div class="project-sort">

                        <span class="project-sort-label">
                            Sort by
                        </span>


                        <select id="sortTasks"
                                class="project-sort-select">

                            <option value="name-asc">
                                Name ↑
                            </option>

                            <option value="name-desc">
                                Name ↓
                            </option>

                            <option value="status-asc">
                                Status ↑
                            </option>

                            <option value="status-desc">
                                Status ↓
                            </option>

                            <option value="priority-asc">
                                Priority ↑
                            </option>

                            <option value="priority-desc">
                                Priority ↓
                            </option>

                            <option value="due-asc">
                                Due Date ↑
                            </option>

                            <option value="due-desc">
                                Due Date ↓
                            </option>

                        </select>

                    </div>


                    <!-- ADD TASK -->
                    @if (Model.IsManager)
                    {
                        <button type="button"
                                class="project-add-button"
                                data-bs-toggle="modal"
                                data-bs-target="#createTaskModal">

                            <i class="mdi mdi-plus-circle-outline"></i>

                            <span>Add</span>

                        </button>
                    }

                </div>

            </div>
        }


        <!-- =====================================================
             EMPLOYEE EMPTY STATE
             ===================================================== -->
        @if (Model.IsEmployee)
        {
            @if (Model.AssignedTasks == null ||
                 Model.AssignedTasks.Count == 0)
            {
                <div class="project-empty-state">

                    <i class="mdi mdi-clipboard-text-outline"></i>

                    <p>
                        You are not currently assigned to any tasks.
                    </p>

                </div>
            }
        }


        <!-- =====================================================
             MANAGER / ADMIN EMPTY STATE
             ===================================================== -->
        @if (!Model.IsEmployee)
        {
            @if (Model.PagedTasks == null)
            {
                <div class="task-empty-state">

                    <i class="mdi mdi-alert-circle-outline"></i>

                    <p>
                        Unable to load tasks.
                    </p>

                </div>
            }
            else if (Model.PagedTasks.Items.Count == 0)
            {
                <div class="task-empty-state">

                    <i class="mdi mdi-clipboard-search-outline"></i>

                    <p>
                        No tasks found.
                    </p>

                </div>
            }
        }


        <!-- =====================================================
             TASK TABLE CHECK
             ===================================================== -->
        @{
            var hasEmployeeTasks =
                Model.IsEmployee &&
                Model.AssignedTasks != null &&
                Model.AssignedTasks.Count > 0;

            var hasManagerTasks =
                !Model.IsEmployee &&
                Model.PagedTasks != null &&
                Model.PagedTasks.Items.Count > 0;
        }


        @if (hasEmployeeTasks || hasManagerTasks)
        {
            <div class="project-table-wrapper">

                <table id="table-main"
                       class="task-datatable">

                    <thead>

                        <tr>

                            <th>
                                Task
                            </th>

                            <th>
                                Assigned To
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Priority
                            </th>

                            <th>
                                Due Date
                            </th>

                            <th>
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        <!-- =================================================
                             EMPLOYEE TASKS
                             ================================================= -->
                        @if (Model.IsEmployee)
                        {
                            foreach (var task in Model.AssignedTasks)
                            {
                                <tr class="task-row"
                                    data-task-name="@task.Title"
                                    data-task-project="@task.ProjectName"
                                    data-task-status="@task.Status"
                                    data-task-priority="@task.Priority"
                                    data-task-due="@task.DueDate">

                                    <!-- TASK -->
                                    <td>

                                        <div class="task-name-cell">

                                            <div class="task-avatar">

                                                <i class="mdi mdi-clipboard-text-outline"></i>

                                            </div>

                                            <div>

                                                <div class="task-name">
                                                    @task.Title
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(task.ProjectName))
                                                {
                                                    <div class="project-description">
                                                        @task.ProjectName
                                                    </div>
                                                }

                                            </div>

                                        </div>

                                    </td>


                                    <!-- ASSIGNED TO -->
                                    <td>

                                        <span class="task-member-names">

                                            @if (task.AssignedToUserNames != null &&
                                                 task.AssignedToUserNames.Count > 0)
                                            {
                                                @string.Join(", ", task.AssignedToUserNames)
                                            }
                                            else
                                            {
                                                <span>Not assigned</span>
                                            }

                                        </span>

                                    </td>


                                    <!-- STATUS -->
                                    <td>

                                        <span class="task-status">
                                            @task.Status
                                        </span>

                                    </td>


                                    <!-- PRIORITY -->
                                    <td>

                                        <span class="task-priority">
                                            @task.Priority
                                        </span>

                                    </td>


                                    <!-- DUE DATE -->
                                    <td>

                                        <span class="task-due-date">

                                            @if (task.DueDate.HasValue)
                                            {
                                                @task.DueDate.Value.ToString("dd MMM yyyy")
                                            }
                                            else
                                            {
                                                <span>No deadline</span>
                                            }

                                        </span>

                                    </td>


                                    <!-- ACTION -->
                                    <td>

                                        <div class="task-actions">

                                            <!-- VIEW -->
                                            <button type="button"
                                                    class="task-view-button"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#taskDetailsModal"
                                                    data-id="@task.Id"
                                                    data-name="@task.Title"
                                                    data-description="@task.Description"
                                                    data-project="@task.ProjectName"
                                                    data-status="@task.Status"
                                                    data-priority="@task.Priority"
                                                    data-members="@string.Join(", ", task.AssignedToUserNames)"
                                                    data-duedate="@(task.DueDate?.ToString("dd MMM yyyy") ?? "No deadline")">

                                                <i class="mdi mdi-eye-outline"></i>

                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }


                        <!-- =================================================
                             MANAGER / ADMIN TASKS
                             ================================================= -->
                        @if (Model.IsManager||Model.IsAdmin &&
                                                     Model.PagedTasks != null)
                        {
                            foreach (var task in Model.PagedTasks.Items)
                            {
                                <tr class="task-row"
                                    data-task-name="@task.Title"
                                    data-task-project="@task.ProjectName"
                                    data-task-status="@task.Status"
                                    data-task-priority="@task.Priority"
                                    data-task-due="@task.DueDate">

                                    <!-- TASK -->
                                    <td>

                                        <div class="task-name-cell">

                                            <div class="task-avatar">

                                                <i class="mdi mdi-clipboard-text-outline"></i>

                                            </div>

                                            <div>

                                                <div class="task-name">
                                                    @task.Title
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(task.ProjectName))
                                                {
                                                    <div class="project-description">
                                                        @task.ProjectName
                                                    </div>
                                                }

                                            </div>

                                        </div>

                                    </td>


                                    <!-- ASSIGNED TO -->
                                    <td>

                                        <span class="task-member-names">

                                            @if (task.AssignedToUserNames != null &&
                                                 task.AssignedToUserNames.Count > 0)
                                            {
                                                @string.Join(", ", task.AssignedToUserNames)
                                            }
                                            else
                                            {
                                                <span>Not assigned</span>
                                            }

                                        </span>

                                    </td>


                                    <!-- STATUS -->
                                    <td>

                                        <span class="task-status">
                                            @task.Status
                                        </span>

                                    </td>


                                    <!-- PRIORITY -->
                                    <td>

                                        <span class="task-priority">
                                            @task.Priority
                                        </span>

                                    </td>


                                    <!-- DUE DATE -->
                                    <td>

                                        <span class="task-due-date">

                                            @if (task.DueDate.HasValue)
                                            {
                                                @task.DueDate.Value.ToString("dd MMM yyyy")
                                            }
                                            else
                                            {
                                                <span>No deadline</span>
                                            }

                                        </span>

                                    </td>


                                    <!-- ACTIONS -->
                                    <td>

                                        <div class="task-actions">

                                            <!-- VIEW DETAILS -->
                                            <button type="button"
                                                    class="project-action-button"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#taskDetailsModal"
                                                    data-id="@task.Id"
                                                    data-name="@task.Title"
                                                    data-description="@task.Description"
                                                    data-project="@task.ProjectName"
                                                    data-status="@task.Status"
                                                    data-priority="@task.Priority"
                                                    data-members="@string.Join(", ", task.AssignedToUserNames)"
                                                    data-duedate="@(task.DueDate?.ToString("dd MMM yyyy") ?? "No deadline")"
                                                    title="View Details">

                                                <i class="mdi mdi-eye-outline"></i>

                                            </button>

                                            @if (Model.IsManager)
                                            {
                                                
                                            
                                            <!-- UPDATE -->
                                            <button type="button"
                                                    class="project-edit-button task-update-button"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#updateTaskModal"
                                                    data-id="@task.Id"
                                                    data-name="@task.Title"
                                                    data-description="@task.Description"
                                                    data-status="@((int)task.Status)"
                                                    data-priority="@task.Priority"
                                                    data-duedate="@(task.DueDate?.ToString("yyyy-MM-dd") ?? "")">

                                                <i class="mdi mdi-pencil-outline"></i>

                                            </button>


                                            <!-- MANAGE MEMBERS -->
                                            <button type="button"
                                                    class="project-member-button task-member-button"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#manageMembersModal"
                                                    data-id="@task.Id"
                                                    data-name="@task.Title"
                                                    data-project-id="@task.ProjectId"
                                                    title="Manage Members">

                                                <i class="mdi mdi-account-multiple-outline"></i>

                                                <span>Manage</span>

                                            </button>
                                            }
                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>
</div>


<!-- =============================================================
     CREATE TASK MODAL
     ============================================================= -->
@if (Model.IsManager)
{
    <div class="modal fade"
         id="createTaskModal"
         tabindex="-1">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h4>
                        Create Task
                    </h4>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <form method="post"
                      asp-page-handler="CreateTask"
                      enctype="multipart/form-data">

                    <div class="modal-body">

                        <!-- PROJECT -->
                        <div class="mt-3">

                            <label class="form-label fw-bold">
                                Project
                            </label>

                            <select asp-for="createTask.ProjectId"
                                    class="form-select"
                                    id="projectSelect">

                                <option value="">
                                    -- Select Project --
                                </option>

                                @foreach (var project in Model.Projects)
                                {
                                    <option value="@project.Id">
                                        @project.Name
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="createTask.ProjectId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- TITLE -->
                        <div class="mb-3">

                            <label asp-for="createTask.Title"></label>

                            <input asp-for="createTask.Title"
                                   class="form-control" />

                            <span asp-validation-for="createTask.Title"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- DESCRIPTION -->
                        <div class="mb-3">

                            <label asp-for="createTask.Description"></label>

                            <textarea asp-for="createTask.Description"
                                      class="form-control"
                                      rows="3">
                            </textarea>

                            <span asp-validation-for="createTask.Description"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- FILE -->
                        <div class="mt-3">

                            <label class="form-label fw-bold">
                                Attach File
                            </label>

                            <input type="file"
                                   asp-for="UploadFile"
                                   class="form-control" />

                            <small class="text-muted">
                                Select a file to attach to this task.
                            </small>

                        </div>


                        <!-- DUE DATE -->
                        <div class="mb-3">

                            <label asp-for="createTask.DueDate"></label>

                            <input asp-for="createTask.DueDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="createTask.DueDate"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- PRIORITY -->
                        <div>

                            <input asp-for="createTask.Priority"
                                   type="hidden" />

                        </div>


                        <!-- PROJECT MEMBERS -->
                        <div class="mt-3">

                            <label class="form-label fw-bold">
                                Assign To
                            </label>

                            <div id="projectMembersContainer"
                                 class="border rounded-3 p-3"
                                 style="max-height:200px; overflow-y:auto;">

                                <div class="text-muted">
                                    Please select a project first.
                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="modal-footer">

                        <button type="button"
                                class="btn-cancel"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>

                        <button class="btn-save"
                                type="submit">

                            Create

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>
}


<!-- =============================================================
     VIEW DETAILS MODAL
     ============================================================= -->

<div class="modal fade task-modal"
     id="taskDetailsModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h3 class="modal-title">
                    Task Details
                </h3>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body">

                <div class="task-detail-row">

                    <span class="task-detail-label">
                        Task
                    </span>

                    <span id="detailsTaskName"
                          class="task-detail-value">
                    </span>

                </div>


                <div class="task-detail-row">

                    <span class="task-detail-label">
                        Project
                    </span>

                    <span id="detailsProject"
                          class="task-detail-value">
                    </span>

                </div>


                <div class="task-detail-row">

                    <span class="task-detail-label">
                        Description
                    </span>

                    <span id="detailsDescription"
                          class="task-detail-value">
                    </span>

                </div>


                <div class="row">

                    <div class="col-md-4">

                        <div class="task-detail-row">

                            <span class="task-detail-label">
                                Status
                            </span>

                            <span id="detailsStatus"
                                  class="task-status">
                            </span>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="task-detail-row">

                            <span class="task-detail-label">
                                Priority
                            </span>

                            <span id="detailsPriority"
                                  class="task-detail-value">
                            </span>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="task-detail-row">

                            <span class="task-detail-label">
                                Due Date
                            </span>

                            <span id="detailsDueDate"
                                  class="task-detail-value">
                            </span>

                        </div>

                    </div>

                </div>


                <div class="task-detail-row">

                    <span class="task-detail-label">
                        Assigned To
                    </span>

                    <span id="detailsMembers"
                          class="task-detail-value">
                    </span>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn-cancel"
                        data-bs-dismiss="modal">

                    Close

                </button>

            </div>

        </div>

    </div>

</div>


<!-- =============================================================
     UPDATE TASK MODAL
     ============================================================= -->
@if (Model.IsManager)
{
    <div class="modal fade task-modal"
         id="updateTaskModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <!-- IMPORTANT:
                     PageModel method is OnPostUpdateAsync()
                     so handler is "Update"
                -->

                <form method="post"
                      asp-page-handler="Update">

                    <div class="modal-header">

                        <h5 class="modal-title">
                            Update Task
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>

                    </div>


                    <div class="modal-body">

                        <input type="hidden"
                               id="editTaskId"
                               name="EditTaskId" />


                        <!-- TASK NAME -->
                        <div class="mb-3">

                            <label class="task-form-label">
                                Task
                            </label>

                            <input type="text"
                                   id="editTaskName"
                                   class="task-form-control"
                                   readonly />

                        </div>


                        <!-- STATUS -->
                        <div class="mb-3">

                            <label class="task-form-label">
                                Status
                            </label>

                            <select id="editTaskStatus"
                                    name="EditStatus"
                                    class="task-form-control">

                                @foreach (var status in Enum.GetValues<ProjectTasksStatus>())
                                {
                                    <option value="@((int)status)">
                                        @status
                                    </option>
                                }

                            </select>

                        </div>


                        <!-- PRIORITY -->
                        <div class="mb-3">

                            <label class="task-form-label">
                                Priority
                            </label>

                            <select id="editTaskPriority"
                                    name="EditPriority"
                                    class="task-form-control">

                                @foreach (var priority in Enum.GetValues<TaskPriority>())
                                {
                                    <option value="@priority">
                                        @priority
                                    </option>
                                }

                            </select>

                        </div>


                        <!-- DUE DATE -->
                        <div class="mb-3">

                            <label class="task-form-label">
                                Due Date
                            </label>

                            <input type="date"
                                   id="editTaskDueDate"
                                   name="EditDueDate"
                                   class="task-form-control" />

                        </div>

                    </div>


                    <div class="modal-footer">

                        <button type="button"
                                class="btn-cancel"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>

                        <button type="submit"
                                class="btn-save">

                            Save Changes

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>
}


<!-- =============================================================
     MANAGE MEMBERS MODAL
     ============================================================= -->
@if (Model.IsManager)
{
    <div class="modal fade task-modal"
         id="manageMembersModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <form method="post"
                      asp-page-handler="AssignMembers">

                    <div class="modal-header">

                        <h5 class="modal-title">

                            <i class="mdi mdi-account-multiple-outline me-2"></i>

                            Manage Task Members

                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>

                    </div>


                    <div class="modal-body">

                        <!-- TASK ID -->
                        <input type="hidden"
                               id="memberTaskId"
                               name="TaskId" />


                        <!-- TASK NAME -->
                        <div class="mb-3">

                            <div class="task-detail-label">
                                Task
                            </div>

                            <div id="memberTaskName"
                                 class="task-detail-value">
                            </div>

                        </div>


                        <!-- PROJECT MEMBERS -->
                        <div class="mb-3">

                            <label class="task-form-label">
                                Assign Members
                            </label>


                            <div id="manageProjectMembersContainer"
                                 class="border rounded-3 p-3"
                                 style="max-height:220px; overflow-y:auto;">

                                <div class="text-muted text-center py-3">
                                    Select a task to load project members.
                                </div>

                            </div>


                            <small class="text-muted">
                                Only members of this task's project are shown.
                            </small>

                        </div>

                    </div>


                    <div class="modal-footer">

                        <button type="button"
                                class="btn-cancel"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>


                        <button type="submit"
                                class="btn-save">

                            <i class="mdi mdi-content-save-outline me-1"></i>

                            Save Members

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>
}


<!-- =============================================================
     JAVASCRIPT
     ============================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function() {

        /* =====================================================
           VIEW DETAILS MODAL
           ===================================================== */

        const detailsModal =
            document.getElementById("taskDetailsModal");

        if (detailsModal) {

            detailsModal.addEventListener(
                "show.bs.modal",
                function(event) {

                    const button =
                        event.relatedTarget;

                    if (!button)
                        return;


                    document.getElementById("detailsTaskName").textContent =
                        button.getAttribute("data-name") || "";


                    document.getElementById("detailsProject").textContent =
                        button.getAttribute("data-project") || "";


                    document.getElementById("detailsDescription").textContent =
                        button.getAttribute("data-description") ||
                        "No description";


                    document.getElementById("detailsStatus").textContent =
                        button.getAttribute("data-status") || "";


                    document.getElementById("detailsPriority").textContent =
                        button.getAttribute("data-priority") || "";


                    document.getElementById("detailsMembers").textContent =
                        button.getAttribute("data-members") ||
                        "Not assigned";


                    document.getElementById("detailsDueDate").textContent =
                        button.getAttribute("data-duedate") ||
                        "No deadline";

                }
            );

        }


        /* =====================================================
           CREATE TASK - LOAD PROJECT MEMBERS
           ===================================================== */

        const projectSelect =
            document.getElementById("projectSelect");

        const projectMembersContainer =
            document.getElementById("projectMembersContainer");


        if (projectSelect && projectMembersContainer) {

            projectSelect.addEventListener(
                "change",
                async function() {

                    const projectId =
                        this.value;


                    if (!projectId) {

                        projectMembersContainer.innerHTML = `
                                <div class="text-muted">
                                    Please select a project first.
                                </div>
                            `;

                        return;
                    }


                    projectMembersContainer.innerHTML = `
                            <div class="text-muted text-center py-3">
                                <div class="spinner-border spinner-border-sm me-2"></div>
                                Loading members...
                            </div>
                        `;


                    try {

                        const response =
                            await fetch(
                                `?handler=ProjectMembers&projectId=${encodeURIComponent(projectId)}`
                            );


                        if (!response.ok) {

                            throw new Error(
                                `ProjectMembers request failed: ${response.status}`
                            );

                        }


                        const members =
                            await response.json();


                        if (!Array.isArray(members) ||
                            members.length === 0) {

                            projectMembersContainer.innerHTML = `
                                    <div class="text-muted text-center py-3">
                                        No project members found.
                                    </div>
                                `;

                            return;
                        }


                        projectMembersContainer.innerHTML = "";


                        members.forEach(function(member) {

                            const wrapper =
                                document.createElement("div");

                            wrapper.className =
                                "form-check mb-2";


                            const checkbox =
                                document.createElement("input");

                            checkbox.className =
                                "form-check-input";

                            checkbox.type =
                                "checkbox";

                            checkbox.name =
                                "createTask.AssignedToUserIds";

                            checkbox.value =
                                member.id;

                            checkbox.id =
                                `createTaskMember_${member.id}`;


                            const label =
                                document.createElement("label");

                            label.className =
                                "form-check-label";

                            label.htmlFor =
                                checkbox.id;

                            label.textContent =
                                member.name ||
                                "Unknown member";


                            wrapper.appendChild(checkbox);

                            wrapper.appendChild(label);

                            projectMembersContainer.appendChild(wrapper);

                        });

                    }
                    catch (error) {

                        console.error(
                            "ProjectMembers Error:",
                            error
                        );


                        projectMembersContainer.innerHTML = `
                                <div class="text-danger">
                                    Something went wrong while loading members.
                                </div>
                            `;

                    }

                }
            );

        }


        /* =====================================================
           CREATE TASK
           ===================================================== */

        function initializeCreateTask() {

            const createForm =
                document.querySelector(
                    "#createTaskModal form"
                );


            if (!createForm) {
                return;
            }


            if (createForm.dataset.initialized === "true") {
                return;
            }


            createForm.dataset.initialized =
                "true";


            createForm.addEventListener(
                "submit",
                async function(e) {

                    e.preventDefault();


                    const form =
                        this;


                    const formData =
                        new FormData(form);


                    const token =
                        getAntiForgeryToken();


                    const submitButton =
                        form.querySelector(
                            'button[type="submit"]'
                        );


                    const originalText =
                        submitButton
                            ? submitButton.innerHTML
                            : "Create";


                    if (submitButton) {

                        submitButton.disabled =
                            true;

                        submitButton.innerHTML = `
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                Creating...
                            `;

                    }


                    try {

                        const response =
                            await fetch(
                                "?handler=CreateTask",
                                {
                                    method: "POST",
                                    body: formData,
                                    headers: {
                                        "RequestVerificationToken":
                                            token
                                    }
                                }
                            );


                        const responseText =
                            await response.text();


                        let result =
                            null;


                        try {

                            result =
                                JSON.parse(
                                    responseText
                                );

                        }
                        catch {

                            result =
                                null;

                        }


                        if (response.ok &&
                            (result === null ||
                                result.success !== false)) {

                            const modalElement =
                                document.getElementById(
                                    "createTaskModal"
                                );


                            if (modalElement) {

                                const modal =
                                    bootstrap.Modal.getInstance(
                                        modalElement
                                    );


                                if (modal) {
                                    modal.hide();
                                }

                            }


                            showToast(
                                result?.message ||
                                "Task created successfully.",
                                "success",
                                "Task Created"
                            );


                            setTimeout(
                                () => {
                                    window.location.reload();
                                },
                                1000
                            );

                        }
                        else {

                            showToast(
                                result?.message ||
                                "Unable to create task.",
                                "error",
                                "Create Failed"
                            );

                        }

                    }
                    catch (error) {

                        console.error(
                            "CreateTask Error:",
                            error
                        );


                        showToast(
                            "Something went wrong while creating the task.",
                            "error",
                            "Create Failed"
                        );

                    }
                    finally {

                        if (submitButton) {

                            submitButton.disabled =
                                false;

                            submitButton.innerHTML =
                                originalText;

                        }

                    }

                }
            );

        }


        initializeCreateTask();


        /* =====================================================
           UPDATE MODAL
           ===================================================== */

        const updateModal =
            document.getElementById("updateTaskModal");


        if (updateModal) {

            updateModal.addEventListener(
                "show.bs.modal",
                function(event) {

                    const button =
                        event.relatedTarget;


                    if (!button)
                        return;


                    const taskId =
                        button.getAttribute("data-id");


                    const taskName =
                        button.getAttribute("data-name");


                    const status =
                        button.getAttribute("data-status");


                    const priority =
                        button.getAttribute("data-priority");


                    const dueDate =
                        button.getAttribute("data-duedate");


                    document.getElementById(
                        "editTaskId"
                    ).value =
                        taskId || "";


                    document.getElementById(
                        "editTaskName"
                    ).value =
                        taskName || "";


                    document.getElementById(
                        "editTaskStatus"
                    ).value =
                        status || "";


                    document.getElementById(
                        "editTaskPriority"
                    ).value =
                        priority || "";


                    document.getElementById(
                        "editTaskDueDate"
                    ).value =
                        dueDate || "";

                }
            );

        }


        /* =====================================================
           MANAGE MEMBERS MODAL
           ===================================================== */

        const membersModal =
            document.getElementById(
                "manageMembersModal"
            );


        const manageProjectMembersContainer =
            document.getElementById(
                "manageProjectMembersContainer"
            );


        if (membersModal &&
            manageProjectMembersContainer) {

            membersModal.addEventListener(
                "show.bs.modal",
                async function(event) {

                    const button =
                        event.relatedTarget;


                    if (!button)
                        return;


                    /* =========================================
                       GET TASK INFORMATION
                       ========================================= */

                    const taskId =
                        button.getAttribute(
                            "data-id"
                        ) || "";


                    const taskName =
                        button.getAttribute(
                            "data-name"
                        ) || "";


                    const projectId =
                        button.getAttribute(
                            "data-project-id"
                        ) || "";


                    document.getElementById(
                        "memberTaskId"
                    ).value =
                        taskId;


                    document.getElementById(
                        "memberTaskName"
                    ).textContent =
                        taskName;


                    /* =========================================
                       LOADING STATE
                       ========================================= */

                    manageProjectMembersContainer.innerHTML = `
                            <div class="text-muted text-center py-3">
                                <div class="spinner-border spinner-border-sm me-2"></div>
                                Loading project members...
                            </div>
                        `;


                    /* =========================================
                       PROJECT ID CHECK
                       ========================================= */

                    if (!projectId) {

                        manageProjectMembersContainer.innerHTML = `
                                <div class="text-danger text-center py-3">
                                    Project information not found for this task.
                                </div>
                            `;

                        return;
                    }


                    try {

                        /* =====================================
                           1. LOAD PROJECT MEMBERS
                           ===================================== */

                        const membersResponse =
                            await fetch(
                                `?handler=ProjectMembers&projectId=${encodeURIComponent(projectId)}`
                            );


                        if (!membersResponse.ok) {

                            throw new Error(
                                `ProjectMembers request failed: ${membersResponse.status}`
                            );

                        }


                        const projectMembers =
                            await membersResponse.json();


                        /* =====================================
                           2. LOAD CURRENT TASK MEMBERS
                           ===================================== */

                        const assignedResponse =
                            await fetch(
                                `?handler=TaskMembers&taskId=${encodeURIComponent(taskId)}`
                            );


                        if (!assignedResponse.ok) {

                            throw new Error(
                                `TaskMembers request failed: ${assignedResponse.status}`
                            );

                        }


                        const assignedMemberIds =
                            await assignedResponse.json();


                        const assignedIds =
                            Array.isArray(
                                assignedMemberIds
                            )
                                ? assignedMemberIds.map(
                                    id => Number(id)
                                )
                                : [];


                        /* =====================================
                           3. CLEAR CONTAINER
                           ===================================== */

                        manageProjectMembersContainer.innerHTML =
                            "";


                        /* =====================================
                           4. NO MEMBERS
                           ===================================== */

                        if (!Array.isArray(projectMembers) ||
                            projectMembers.length === 0) {

                            manageProjectMembersContainer.innerHTML = `
                                    <div class="text-muted text-center py-3">
                                        No members found in this project.
                                    </div>
                                `;

                            return;
                        }


                        /* =====================================
                           5. CREATE CHECKBOXES
                           ===================================== */

                        projectMembers.forEach(
                            function(member) {

                                const wrapper =
                                    document.createElement(
                                        "div"
                                    );


                                wrapper.className =
                                    "form-check mb-2";


                                const checkbox =
                                    document.createElement(
                                        "input"
                                    );


                                checkbox.type =
                                    "checkbox";


                                checkbox.className =
                                    "form-check-input";


                                /*
                                 * IMPORTANT:
                                 * This name must match
                                 * List<int> AssignedToUserIds
                                 */
                                checkbox.name =
                                    "AssignedToUserIds";


                                checkbox.value =
                                    member.id;


                                checkbox.id =
                                    `manageTaskMember_${member.id}`;


                                /* =================================
                                   CHECK CURRENTLY ASSIGNED MEMBERS
                                   ================================= */

                                if (
                                    assignedIds.includes(
                                        Number(member.id)
                                    )
                                ) {

                                    checkbox.checked =
                                        true;

                                }


                                const label =
                                    document.createElement(
                                        "label"
                                    );


                                label.className =
                                    "form-check-label";


                                label.htmlFor =
                                    checkbox.id;


                                label.textContent =
                                    member.name ||
                                    "Unknown member";


                                wrapper.appendChild(
                                    checkbox
                                );


                                wrapper.appendChild(
                                    label
                                );


                                manageProjectMembersContainer.appendChild(
                                    wrapper
                                );

                            }
                        );

                    }
                    catch (error) {

                        console.error(
                            "Manage Members Error:",
                            error
                        );


                        manageProjectMembersContainer.innerHTML = `
                                <div class="text-danger text-center py-3">
                                    Something went wrong while loading project members.
                                </div>
                            `;

                    }

                }
            );

        }


        /* =====================================================
           FILTER PANEL
           ===================================================== */

        const filterButton =
            document.getElementById(
                "filterButton"
            );


        const filterPanel =
            document.getElementById(
                "filterPanel"
            );


        if (filterButton &&
            filterPanel) {

            filterButton.addEventListener(
                "click",
                function(event) {

                    event.stopPropagation();


                    filterPanel.classList.toggle(
                        "show"
                    );


                    filterButton.classList.toggle(
                        "active"
                    );

                }
            );


            document.addEventListener(
                "click",
                function(event) {

                    if (
                        !filterPanel.contains(
                            event.target
                        ) &&
                        !filterButton.contains(
                            event.target
                        )
                    ) {

                        filterPanel.classList.remove(
                            "show"
                        );


                        filterButton.classList.remove(
                            "active"
                        );

                    }

                }
            );

        }


        /* =====================================================
           SEARCH
           ===================================================== */

        const searchInput =
            document.getElementById(
                "taskSearch"
            );


        const rows =
            Array.from(
                document.querySelectorAll(
                    ".task-row"
                )
            );


        function applyTaskFilters() {

            const searchValue =
                (searchInput?.value || "")
                    .trim()
                    .toLowerCase();


            const statusValue =
                document.getElementById(
                    "statusFilter"
                )?.value || "";


            rows.forEach(
                function(row) {

                    const name =
                        (
                            row.getAttribute(
                                "data-task-name"
                            ) || ""
                        ).toLowerCase();


                    const project =
                        (
                            row.getAttribute(
                                "data-task-project"
                            ) || ""
                        ).toLowerCase();


                    const status =
                        (
                            row.getAttribute(
                                "data-task-status"
                            ) || ""
                        ).toLowerCase();


                    const matchesSearch =
                        name.includes(
                            searchValue
                        ) ||
                        project.includes(
                            searchValue
                        );


                    const matchesStatus =
                        !statusValue ||
                        status ===
                        statusValue.toLowerCase();


                    row.style.display =
                        matchesSearch &&
                            matchesStatus
                            ? ""
                            : "none";

                }
            );

        }


        if (searchInput) {

            searchInput.addEventListener(
                "input",
                applyTaskFilters
            );

        }


        /* =====================================================
           CLEAR FILTER
           ===================================================== */

        const clearFilter =
            document.getElementById(
                "clearFilter"
            );


        if (clearFilter) {

            clearFilter.addEventListener(
                "click",
                function() {

                    if (searchInput) {
                        searchInput.value = "";
                    }


                    const statusFilter =
                        document.getElementById(
                            "statusFilter"
                        );


                    if (statusFilter) {
                        statusFilter.value = "";
                    }


                    applyTaskFilters();

                }
            );

        }


        /* =====================================================
           SORT
           ===================================================== */

        const sortSelect =
            document.getElementById(
                "sortTasks"
            );


        const tableBody =
            document.querySelector(
                "#table-main tbody"
            );


        if (sortSelect &&
            tableBody) {

            sortSelect.addEventListener(
                "change",
                function() {

                    const value =
                        sortSelect.value;


                    const parts =
                        value.split("-");


                    const field =
                        parts[0];


                    const direction =
                        parts[1];


                    const sortedRows =
                        Array.from(
                            tableBody.querySelectorAll(
                                ".task-row"
                            )
                        );


                    sortedRows.sort(
                        function(a, b) {

                            let aValue = "";
                            let bValue = "";


                            if (field === "name") {

                                aValue =
                                    a.getAttribute(
                                        "data-task-name"
                                    ) || "";


                                bValue =
                                    b.getAttribute(
                                        "data-task-name"
                                    ) || "";

                            }
                            else if (
                                field === "status"
                            ) {

                                aValue =
                                    a.getAttribute(
                                        "data-task-status"
                                    ) || "";


                                bValue =
                                    b.getAttribute(
                                        "data-task-status"
                                    ) || "";

                            }
                            else if (
                                field === "priority"
                            ) {

                                aValue =
                                    a.getAttribute(
                                        "data-task-priority"
                                    ) || "";


                                bValue =
                                    b.getAttribute(
                                        "data-task-priority"
                                    ) || "";

                            }
                            else if (
                                field === "due"
                            ) {

                                aValue =
                                    a.getAttribute(
                                        "data-task-due"
                                    ) || "";


                                bValue =
                                    b.getAttribute(
                                        "data-task-due"
                                    ) || "";

                            }


                            aValue =
                                aValue.toLowerCase();


                            bValue =
                                bValue.toLowerCase();


                            let result =
                                aValue.localeCompare(
                                    bValue,
                                    undefined,
                                    {
                                        numeric: true,
                                        sensitivity: "base"
                                    }
                                );


                            return direction === "desc"
                                ? -result
                                : result;

                        }
                    );


                    sortedRows.forEach(
                        function(row) {

                            tableBody.appendChild(
                                row
                            );

                        }
                    );

                }
            );

        }

    });

</script>