@page
@model TaskTracker.Pages.ProjectTasks.IndexModel

@using TaskTrackerDAL.Models.Enums

@{
    ViewData["Title"] = "Tasks";
}

<link rel="stylesheet" href="~/css/project.css" />
<link rel="stylesheet" href="~/css/tasks.css" />

<div class="tasks-page">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="project-page-header">

        @if (Model.IsAdmin || Model.IsManager)
        {
            <h2 class="project-page-title">Tasks</h2>
        }
        else
        {
            <h2 class="project-page-title">Tasks</h2>

            <p class="project-page-subtitle">
                You are assigned to
            </p>
        }

    </div>


    <!-- =========================================================
         TASK TABLE CARD
         ========================================================= -->

    <div class="project-table-card">

        <!-- =====================================================
             TOOLBAR
             ===================================================== -->
        @if (Model.IsManager || Model.IsAdmin)
        {
            <div class="project-toolbar">

                <!-- SEARCH -->
                <div class="project-search">

                    <i class="mdi mdi-magnify project-search-icon"></i>

                    <input type="search"
                           id="taskSearch"
                           autocomplete="off"
                           placeholder="Search tasks..." />

                </div>
                <!-- PROJECT FILTER -->
                <div class="project-filter-wrapper">

                    <select id="projectFilter"
                            class="form-select select-search">

                        <option value="">
                            All Projects
                        </option>


                        @foreach (var project in Model.Projects)
                        {
                            <option value="@project.Name">
                                @project.Name
                            </option>
                        }


                    </select>

                </div>




                <!-- MEMBER FILTER -->
                <div class="project-filter-wrapper">


                    <select id="memberFilter"
                            class="form-select select-search">


                        <option value="">
                            All Members
                        </option>


                        @foreach (var employee in Model.AllEmployees)
                        {
                            <option value="@employee.FullName">
                                @employee.FullName
                            </option>
                        }


                    </select>


                </div>

                <!-- RIGHT SIDE -->
                <div class="project-toolbar-right">

                    <!-- FILTER -->
                    <div class="project-filter-wrapper">

                        <button type="button"
                                id="filterButton"
                                class="project-filter-button">

                            <i class="mdi mdi-filter-variant"></i>

                            <span>Filter</span>

                        </button>


                        <div id="filterPanel"
                             class="project-filter-panel">

                            <div class="project-filter-title">
                                Task Status
                            </div>


                            <select id="statusFilter"
                                    class="project-filter-select">

                                <option value="">
                                    All Tasks
                                </option>

                                @foreach (var status in Enum.GetValues<ProjectTasksStatus>())
                                {
                                    <option value="@status">
                                        @status
                                    </option>
                                }

                            </select>


                            <button type="button"
                                    id="clearFilter"
                                    class="project-filter-clear">

                                Clear filter

                            </button>

                        </div>

                    </div>


                    <!-- SORT -->
                    <div class="project-sort">

                        <span class="project-sort-label">
                            Sort by
                        </span>


                        <select id="sortTasks"
                                class="project-sort-select">

                            <option value="name-asc">
                                Name ↑
                            </option>

                            <option value="name-desc">
                                Name ↓
                            </option>

                            <option value="status-asc">
                                Status ↑
                            </option>

                            <option value="status-desc">
                                Status ↓
                            </option>

                            <option value="priority-asc">
                                Priority ↑
                            </option>

                            <option value="priority-desc">
                                Priority ↓
                            </option>

                            <option value="due-asc">
                                Due Date ↑
                            </option>

                            <option value="due-desc">
                                Due Date ↓
                            </option>

                        </select>

                    </div>


                    <!-- ADD TASK -->
                    @if (Model.IsManager)
                    {
                        <button type="button"
                                class="project-add-button"
                                data-bs-toggle="modal"
                                data-bs-target="#createTaskModal">

                            <i class="mdi mdi-plus-circle-outline"></i>

                            <span>Add</span>

                        </button>
                    }

                </div>

            </div>
        }


        <!-- =====================================================
             EMPLOYEE EMPTY STATE
             ===================================================== -->
        @if (Model.IsEmployee)
        {
            @if (Model.AssignedTasks == null ||
                 Model.AssignedTasks.Count == 0)
            {
                <div class="project-empty-state">

                    <i class="mdi mdi-clipboard-text-outline"></i>

                    <p>
                        You are not currently assigned to any tasks.
                    </p>

                </div>
            }
        }


        <!-- =====================================================
             MANAGER / ADMIN EMPTY STATE
             ===================================================== -->
        @if (!Model.IsEmployee)
        {
            @if (Model.PagedTasks == null)
            {
                <div class="task-empty-state">

                    <i class="mdi mdi-alert-circle-outline"></i>

                    <p>
                        Unable to load tasks.
                    </p>

                </div>
            }
            else if (Model.PagedTasks.Items.Count == 0)
            {
                <div class="task-empty-state">

                    <i class="mdi mdi-clipboard-search-outline"></i>

                    <p>
                        No tasks found.
                    </p>

                </div>
            }
        }


        <!-- =====================================================
             TASK TABLE CHECK
             ===================================================== -->
        @{
            var hasEmployeeTasks =
                Model.IsEmployee &&
                Model.AssignedTasks != null &&
                Model.AssignedTasks.Count > 0;

            var hasManagerTasks =
                !Model.IsEmployee &&
                Model.PagedTasks != null &&
                Model.PagedTasks.Items.Count > 0;
        }


        @if (hasEmployeeTasks || hasManagerTasks)
        {
            <div class="project-table-wrapper">

                <table id="table-main"
                       class="task-datatable">

                    <thead>

                        <tr>

                            <th>
                                Task
                            </th>

                            <th>
                                Assigned To
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Priority
                            </th>

                            <th>
                                Due Date
                            </th>

                            <th>
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        <!-- =================================================
                             EMPLOYEE TASKS
                             ================================================= -->
                        @if (Model.IsEmployee)
                        {
                            foreach (var task in Model.AssignedTasks)
                            {
                                <tr class="task-row"
                                    data-task-name="@task.Title"
                                    data-task-project="@task.ProjectName"
                                    data-task-member="@string.Join(",", task.AssignedToUserNames)"
                                    data-task-status="@task.Status"
                                    data-task-priority="@task.Priority"
                                    data-task-due="@task.DueDate">

                                    <!-- TASK -->
                                    <td>

                                        <div class="task-name-cell">

                                            <div class="task-avatar">

                                                <i class="mdi mdi-clipboard-text-outline"></i>

                                            </div>

                                            <div>

                                                <div class="task-name">
                                                    @task.Title
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(task.ProjectName))
                                                {
                                                    <div class="project-description">
                                                        @task.ProjectName
                                                    </div>
                                                }

                                            </div>

                                        </div>

                                    </td>


                                    <!-- ASSIGNED TO -->
                                    <td>

                                        <span class="task-member-names">

                                            @if (task.AssignedToUserNames != null &&
                                                 task.AssignedToUserNames.Count > 0)
                                            {
                                                @string.Join(", ", task.AssignedToUserNames)
                                            }
                                            else
                                            {
                                                <span>Not assigned</span>
                                            }

                                        </span>

                                    </td>


                                    <!-- STATUS -->
                                    <td>

                                        <span class="task-status">
                                            @task.Status
                                        </span>

                                    </td>


                                    <!-- PRIORITY -->
                                    <td>

                                        <span class="task-priority">
                                            @task.Priority
                                        </span>

                                    </td>


                                    <!-- DUE DATE -->
                                    <td>

                                        <span class="task-due-date">

                                            @if (task.DueDate.HasValue)
                                            {
                                                @task.DueDate.Value.ToString("dd MMM yyyy")
                                            }
                                            else
                                            {
                                                <span>No deadline</span>
                                            }

                                        </span>

                                    </td>


                                    <!-- ACTION -->
                                    <td>

                                        <div class="task-actions">

                                            <!-- VIEW -->
                                            <button type="button"
                                                    class="task-view-button"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#taskDetailsModal"
                                                    data-id="@task.Id"
                                                    data-name="@task.Title"
                                                    data-description="@task.Description"
                                                    data-project="@task.ProjectName"
                                                    data-status="@task.Status"
                                                    data-priority="@task.Priority"
                                                    data-members="@string.Join(", ", task.AssignedToUserNames)"
                                                    data-duedate="@(task.DueDate?.ToString("dd MMM yyyy") ?? "No deadline")">

                                                <i class="mdi mdi-eye-outline"></i>

                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }


                        <!-- =================================================
                             MANAGER / ADMIN TASKS
                             ================================================= -->
                        @if (Model.IsManager || Model.IsAdmin &&
                                                     Model.PagedTasks != null)
                        {
                            foreach (var task in Model.PagedTasks.Items)
                            {
                                <tr class="task-row"
                                    data-task-name="@task.Title"
                                    data-task-project="@task.ProjectName"
                                    data-task-member="@string.Join(",", task.AssignedToUserNames)"
                                    data-task-status="@task.Status"
                                    data-task-priority="@task.Priority"
                                    data-task-due="@task.DueDate">

                                    <!-- TASK -->
                                    <td>

                                        <div class="task-name-cell">

                                            <div class="task-avatar">

                                                <i class="mdi mdi-clipboard-text-outline"></i>

                                            </div>

                                            <div>

                                                <div class="task-name">
                                                    @task.Title
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(task.ProjectName))
                                                {
                                                    <div class="project-description">
                                                        @task.ProjectName
                                                    </div>
                                                }

                                            </div>

                                        </div>

                                    </td>


                                    <!-- ASSIGNED TO -->
                                    <td>

                                        <span class="task-member-names">

                                            @if (task.AssignedToUserNames != null &&
                                                 task.AssignedToUserNames.Count > 0)
                                            {
                                                @string.Join(", ", task.AssignedToUserNames)
                                            }
                                            else
                                            {
                                                <span>Not assigned</span>
                                            }

                                        </span>

                                    </td>


                                    <!-- STATUS -->
                                    <td>

                                        <span class="task-status">
                                            @task.Status
                                        </span>

                                    </td>


                                    <!-- PRIORITY -->
                                    <td>

                                        <span class="task-priority">
                                            @task.Priority
                                        </span>

                                    </td>


                                    <!-- DUE DATE -->
                                    <td>

                                        <span class="task-due-date">

                                            @if (task.DueDate.HasValue)
                                            {
                                                @task.DueDate.Value.ToString("dd MMM yyyy")
                                            }
                                            else
                                            {
                                                <span>No deadline</span>
                                            }

                                        </span>

                                    </td>


                                    <!-- ACTIONS -->
                                    <td>

                                        <div class="task-actions">

                                            <!-- VIEW DETAILS -->
                                            <button type="button"
                                                    class="project-action-button"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#taskDetailsModal"
                                                    data-id="@task.Id"
                                                    data-name="@task.Title"
                                                    data-description="@task.Description"
                                                    data-project="@task.ProjectName"
                                                    data-status="@task.Status"
                                                    data-priority="@task.Priority"
                                                    data-members="@string.Join(", ", task.AssignedToUserNames)"
                                                    data-duedate="@(task.DueDate?.ToString("dd MMM yyyy") ?? "No deadline")"
                                                    title="View Details">

                                                <i class="mdi mdi-eye-outline"></i>

                                            </button>

                                            @if (Model.IsManager)
                                            {

                                                
                                                <!-- UPDATE -->
                                                <button type="button"
                                                        class="project-edit-button task-update-button"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#updateTaskModal"
                                                        data-id="@task.Id"
                                                        data-name="@task.Title"
                                                        data-description="@task.Description"
                                                        data-status="@task.Status"
                                                        data-priority="@task.Priority"
                                                        data-duedate="@(task.DueDate?.ToString("yyyy-MM-dd") ?? "")"
                                                        data-files="@task.Id">
                                                    <i class="mdi mdi-pencil-outline"></i>
                                                </button>


                                                <!-- MANAGE MEMBERS 
                                                <button type="button"
                                                        class="project-member-button task-member-button"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#manageMembersModal"
                                                        data-id="@task.Id"
                                                        data-name="@task.Title"
                                                        data-project-id="@task.ProjectId"
                                                        title="Manage Members">

                                                    <i class="mdi mdi-account-multiple-outline"></i>

                                                    <span>Manage</span>
                                                </button>-->
                                                <!-- TRANSFER -->
                                                <button type="button"
                                                        class="project-action-button task-transfer-button"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#transferTaskModal"
                                                        data-id="@task.Id"
                                                        data-name="@task.Title"
                                                        data-project-id="@task.ProjectId"
                                                        title="Transfer Task">

                                                    <i class="mdi mdi-swap-horizontal"></i>

                                                    <span>Transfer</span>

                                                </button>
                                            }
                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>
</div>


<!-- =============================================================
     CREATE TASK MODAL
     ============================================================= -->
@if (Model.IsManager)
{
    <div class="modal fade"
         id="createTaskModal"
         tabindex="-1">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h4>
                        Create Task
                    </h4>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <form method="post"
                      asp-page-handler="CreateTask"
                      enctype="multipart/form-data">

                    <div class="modal-body">

                        <!-- PROJECT -->
                        <div class="mt-3">

                            <label class="form-label fw-bold">
                                Project
                            </label>

                            <select asp-for="createTask.ProjectId"
                                    class="form-select"
                                    id="projectSelect">

                                <option value="">
                                    -- Select Project --
                                </option>

                                @foreach (var project in Model.Projects)
                                {
                                    <option value="@project.Id">
                                        @project.Name
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="createTask.ProjectId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- TITLE -->
                        <div class="mb-3">

                            <label asp-for="createTask.Title"></label>

                            <input asp-for="createTask.Title"
                                   class="form-control" />

                            <span asp-validation-for="createTask.Title"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- DESCRIPTION -->
                        <div class="mb-3">

                            <label asp-for="createTask.Description"></label>

                            <textarea asp-for="createTask.Description"
                                      class="form-control"
                                      rows="3">
                            </textarea>

                            <span asp-validation-for="createTask.Description"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- FILE -->
                        <div class="mt-3">

                            <label class="form-label fw-bold">
                                Attach File
                            </label>

                            <input type="file"
                                   asp-for="UploadFile"
                                   class="form-control" />

                            <small class="text-muted">
                                Select a file to attach to this task.
                            </small>

                        </div>


                        <!-- DUE DATE -->
                        <div class="mb-3">

                            <label asp-for="createTask.DueDate"></label>

                            <input asp-for="createTask.DueDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="createTask.DueDate"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- PRIORITY -->
                        <div>

                            <input asp-for="createTask.Priority"
                                   type="hidden" />

                        </div>


                        <!-- PROJECT MEMBERS -->
                        <div class="mt-3">

                            <label class="form-label fw-bold">
                                Assign To
                            </label>

                            <div id="projectMembersContainer"
                                 class="border rounded-3 p-3"
                                 style="max-height:200px; overflow-y:auto;">

                                <div class="text-muted">
                                    Please select a project first.
                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="modal-footer">

                        <button type="button"
                                class="btn-cancel"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>

                        <button class="btn-save"
                                type="submit">

                            Create

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>
}


<!-- =============================================================
     VIEW DETAILS MODAL
     ============================================================= -->

<div class="modal fade task-modal"
     id="taskDetailsModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h3 class="modal-title">
                    Task Details
                </h3>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body">

                <div class="task-detail-row">

                    <span class="task-detail-label">
                        Task
                    </span>

                    <span id="detailsTaskName"
                          class="task-detail-value">
                    </span>

                </div>


                <div class="task-detail-row">

                    <span class="task-detail-label">
                        Project
                    </span>

                    <span id="detailsProject"
                          class="task-detail-value">
                    </span>

                </div>


                <div class="task-detail-row">

                    <span class="task-detail-label">
                        Description
                    </span>

                    <span id="detailsDescription"
                          class="task-detail-value">
                    </span>

                </div>


                <div class="row">

                    <div class="col-md-4">

                        <div class="task-detail-row">

                            <span class="task-detail-label">
                                Status
                            </span>

                            <span id="detailsStatus"
                                  class="task-status">
                            </span>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="task-detail-row">

                            <span class="task-detail-label">
                                Priority
                            </span>

                            <span id="detailsPriority"
                                  class="task-detail-value">
                            </span>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="task-detail-row">

                            <span class="task-detail-label">
                                Due Date
                            </span>

                            <span id="detailsDueDate"
                                  class="task-detail-value">
                            </span>

                        </div>

                    </div>

                </div>


                <div class="task-detail-row">

                    <span class="task-detail-label">
                        Assigned To
                    </span>

                    <span id="detailsMembers"
                          class="task-detail-value">
                    </span>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn-cancel"
                        data-bs-dismiss="modal">

                    Close

                </button>

            </div>

        </div>

    </div>

</div>


<!-- =============================================================
     UPDATE TASK MODAL
     ============================================================= -->
@if (Model.IsManager)
{
    <!-- =============================================================
     UPDATE TASK MODAL
     ============================================================= -->

    <div class="modal fade"
         id="updateTaskModal"
         tabindex="-1">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">


                <div class="modal-header">

                    <h4 class="modal-title">
                        Edit Task
                    </h4>


                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>



                <form method="post"
                      asp-page-handler="Update"
                      enctype="multipart/form-data">


                    <div class="modal-body">


                        <!-- TASK ID -->
                        <input type="hidden"
                               asp-for="EditTaskId"
                               id="editTaskId" />



                        <!-- TITLE -->
                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Task Title
                            </label>


                            <input type="text"
                                   class="form-control"
                                   asp-for="EditTitle"
                                   id="editTitle" />


                        </div>





                        <!-- DESCRIPTION -->
                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Description
                            </label>


                            <textarea class="form-control"
                                      rows="4"
                                      asp-for="EditDescription"
                                      id="editDescription"></textarea>


                        </div>






                        <!-- EXISTING FILES -->
                        <div class="mb-3">


                            <label class="form-label fw-bold">
                                Attached Files
                            </label>



                            <div id="existingFiles"
                                 class="border rounded p-3">


                                <span class="text-muted">
                                    No files attached
                                </span>


                            </div>



                        </div>







                        <!-- ADD NEW FILE -->
                        <div class="mb-3">


                            <label class="form-label fw-bold">
                                Add New File
                            </label>


                            <input type="file"
                                   asp-for="EditUploadFile"
                                   class="form-control" />


                        </div>







                        <!-- STATUS -->
                        <div class="mb-3">


                            <label class="form-label fw-bold">
                                Status
                            </label>



                            <select asp-for="EditStatus"
                                    class="form-select">


                                @foreach (var status in Enum.GetValues<ProjectTasksStatus>())
                                {

                                    <option value="@status">
                                        @status
                                    </option>

                                }


                            </select>


                        </div>









                        <!-- PRIORITY -->
                        <div class="mb-3">


                            <label class="form-label fw-bold">
                                Priority
                            </label>



                            <select asp-for="EditPriority"
                                    id="EditPriority"
                                    class="form-select">


                                @foreach (var priority in Enum.GetValues<TaskPriority>())
                                {
                                    <option value="@priority">
                                        @priority
                                    </option>
                                }


                            </select>


                        </div>







                        <!-- DUE DATE -->
                        <div class="mb-3">


                            <label class="form-label fw-bold">
                                Due Date
                            </label>


                            <input type="date"
                                   asp-for="EditDueDate"
                                   class="form-control"
                                   id="editDueDate" />


                        </div>



                    </div>





                    <div class="modal-footer">


                        <button type="button"
                                class="btn-cancel"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>



                        <button type="submit"
                                class="btn-save">

                            Update

                        </button>


                    </div>


                </form>


            </div>

        </div>

    </div>
}


<!-- =============================================================
     MANAGE MEMBERS MODAL
     ============================================================= -->
@if (Model.IsManager)
{
    <div class="modal fade task-modal"
         id="manageMembersModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <form method="post"
                      asp-page-handler="AssignMembers">

                    <div class="modal-header">

                        <h5 class="modal-title">

                            <i class="mdi mdi-account-multiple-outline me-2"></i>

                            Manage Task Members

                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>

                    </div>


                    <div class="modal-body">

                        <!-- TASK ID -->
                        <input type="hidden"
                               id="memberTaskId"
                               name="TaskId" />


                        <!-- TASK NAME -->
                        <div class="mb-3">

                            <div class="task-detail-label">
                                Task
                            </div>

                            <div id="memberTaskName"
                                 class="task-detail-value">
                            </div>

                        </div>


                        <!-- PROJECT MEMBERS -->
                        <div class="mb-3">

                            <label class="task-form-label">
                                Assign Members
