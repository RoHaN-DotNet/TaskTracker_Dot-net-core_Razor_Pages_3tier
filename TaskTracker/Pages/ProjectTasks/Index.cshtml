<!-- =============================================================
     JAVASCRIPT
     ============================================================= -->
@section Scripts {
<script>

    document.addEventListener("DOMContentLoaded", function() {

        /* =====================================================
           VIEW DETAILS MODAL
           ===================================================== */

        const detailsModal =
            document.getElementById("taskDetailsModal");

        if (detailsModal) {

            detailsModal.addEventListener(
                "show.bs.modal",
                function(event) {

                    const button =
                        event.relatedTarget;

                    if (!button)
                        return;


                    document.getElementById("detailsTaskName").textContent =
                        button.getAttribute("data-name") || "";


                    document.getElementById("detailsProject").textContent =
                        button.getAttribute("data-project") || "";


                    document.getElementById("detailsDescription").textContent =
                        button.getAttribute("data-description") ||
                        "No description";


                    document.getElementById("detailsStatus").textContent =
                        button.getAttribute("data-status") || "";


                    document.getElementById("detailsPriority").textContent =
                        button.getAttribute("data-priority") || "";


                    document.getElementById("detailsMembers").textContent =
                        button.getAttribute("data-members") ||
                        "Not assigned";


                    document.getElementById("detailsDueDate").textContent =
                        button.getAttribute("data-duedate") ||
                        "No deadline";

                }
            );

        }


        /* =====================================================
           CREATE TASK - LOAD PROJECT MEMBERS
           ===================================================== */

        const projectSelect =
            document.getElementById("projectSelect");

        const projectMembersContainer =
            document.getElementById("projectMembersContainer");


        if (projectSelect && projectMembersContainer) {

            projectSelect.addEventListener(
                "change",
                async function() {

                    const projectId =
                        this.value;


                    if (!projectId) {

                        projectMembersContainer.innerHTML = `
                                        <div class="text-muted">
                                            Please select a project first.
                                        </div>
                                    `;

                        return;
                    }


                    projectMembersContainer.innerHTML = `
                                    <div class="text-muted text-center py-3">
                                        <div class="spinner-border spinner-border-sm me-2"></div>
                                        Loading members...
                                    </div>
                                `;


                    try {

                        const response =
                            await fetch(
                                `?handler=ProjectMembers&projectId=${encodeURIComponent(projectId)}`
                            );


                        if (!response.ok) {

                            throw new Error(
                                `ProjectMembers request failed: ${response.status}`
                            );

                        }


                        const members =
                            await response.json();


                        if (!Array.isArray(members) ||
                            members.length === 0) {

                            projectMembersContainer.innerHTML = `
                                            <div class="text-muted text-center py-3">
                                                No project members found.
                                            </div>
                                        `;

                            return;
                        }


                        projectMembersContainer.innerHTML = "";


                        members.forEach(function(member) {

                            const wrapper =
                                document.createElement("div");

                            wrapper.className =
                                "form-check mb-2";


                            const checkbox =
                                document.createElement("input");

                            checkbox.className =
                                "form-check-input";

                            checkbox.type =
                                "checkbox";

                            checkbox.name =
                                "createTask.AssignedToUserIds";

                            checkbox.value =
                                member.id;

                            checkbox.id =
                                `createTaskMember_${member.id}`;


                            const label =
                                document.createElement("label");

                            label.className =
                                "form-check-label";

                            label.htmlFor =
                                checkbox.id;

                            label.textContent =
                                member.name ||
                                "Unknown member";


                            wrapper.appendChild(checkbox);

                            wrapper.appendChild(label);

                            projectMembersContainer.appendChild(wrapper);

                        });

                    }
                    catch (error) {

                        console.error(
                            "ProjectMembers Error:",
                            error
                        );


                        projectMembersContainer.innerHTML = `
                                        <div class="text-danger">
                                            Something went wrong while loading members.
                                        </div>
                                    `;

                    }

                }
            );

        }


        /* =====================================================
           CREATE TASK
           ===================================================== */

        function initializeCreateTask() {

            const createForm =
                document.querySelector(
                    "#createTaskModal form"
                );


            if (!createForm) {
                return;
            }


            if (createForm.dataset.initialized === "true") {
                return;
            }


            createForm.dataset.initialized =
                "true";


            createForm.addEventListener(
                "submit",
                async function(e) {

                    e.preventDefault();


                    const form =
                        this;


                    const formData =
                        new FormData(form);


                    const token =
                        getAntiForgeryToken();


                    const submitButton =
                        form.querySelector(
                            'button[type="submit"]'
                        );


                    const originalText =
                        submitButton
                            ? submitButton.innerHTML
                            : "Create";


                    if (submitButton) {

                        submitButton.disabled =
                            true;

                        submitButton.innerHTML = `
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                        Creating...
                                    `;

                    }


                    try {

                        const response =
                            await fetch(
                                "?handler=CreateTask",
                                {
                                    method: "POST",
                                    body: formData,
                                    headers: {
                                        "RequestVerificationToken":
                                            token
                                    }
                                }
                            );


                        const responseText =
                            await response.text();


                        let result =
                            null;


                        try {

                            result =
                                JSON.parse(
                                    responseText
                                );

                        }
                        catch {

                            result =
                                null;

                        }


                        if (response.ok &&
                            (result === null ||
                                result.success !== false)) {

                            const modalElement =
                                document.getElementById(
                                    "createTaskModal"
                                );


                            if (modalElement) {

                                const modal =
                                    bootstrap.Modal.getInstance(
                                        modalElement
                                    );


                                if (modal) {
                                    modal.hide();
                                }

                            }


                            showToast(
                                result?.message ||
                                "Task created successfully.",
                                "success",
                                "Task Created"
                            );


                            setTimeout(
                                () => {
                                    window.location.reload();
                                },
                                1000
                            );

                        }
                        else {

                            showToast(
                                result?.message ||
                                "Unable to create task.",
                                "error",
                                "Create Failed"
                            );

                        }

                    }
                    catch (error) {

                        console.error(
                            "CreateTask Error:",
                            error
                        );


                        showToast(
                            "Something went wrong while creating the task.",
                            "error",
                            "Create Failed"
                        );

                    }
                    finally {

                        if (submitButton) {

                            submitButton.disabled =
                                false;

                            submitButton.innerHTML =
                                originalText;

                        }

                    }

                }
            );

        }


        initializeCreateTask();


        /* =====================================================
           UPDATE MODAL
           ===================================================== */
        /* =====================================================
    UPDATE MODAL — populate fields + load existing files
    (FIXED: consolidated into one handler using the
    correct element IDs; the old handler above referenced
    IDs like "editTaskName"/"editTaskStatus" that don't
    exist on this page, and silently threw before ever
    reaching a description update, and loadTaskFiles()
    was called but never defined.)
    ===================================================== */

        const updateModal =
            document.getElementById("updateTaskModal");

        if (updateModal) {

            updateModal.addEventListener(
                "show.bs.modal",
                function(event) {

                    const button = event.relatedTarget;

                    if (!button) {
                        return;
                    }

                    const taskId =
                        button.getAttribute("data-id") || "";

                    document.getElementById("editTaskId").value = taskId;
                    document.getElementById("editTitle").value =
                        button.getAttribute("data-name") || "";
                    document.getElementById("editDescription").value =
                        button.getAttribute("data-description") || "";
                    document.getElementById("EditStatus").value =
                        button.getAttribute("data-status") || "";
                    document.getElementById("EditPriority").value =
                        button.getAttribute("data-priority") || "";
                    document.getElementById("editDueDate").value =
                        button.getAttribute("data-duedate") || "";

                    loadTaskFiles(taskId);
                }
            );
        }


        /* =====================================================
           EXISTING TASK FILES — load + individual delete
           NEW: this function was being called but never existed,
           which is why the Edit modal always showed the static
           "No files attached" placeholder.
           ===================================================== */

        function formatFileSizeFallback(bytes) {

            if (!bytes || bytes <= 0) {
                return "";
            }

            if (bytes < 1024) {
                return bytes + " B";
            }

            if (bytes < 1024 * 1024) {
                return (bytes / 1024).toFixed(1) + " KB";
            }

            return (bytes / (1024 * 1024)).toFixed(1) + " MB";
        }

        async function loadTaskFiles(taskId) {

            const container = document.getElementById("existingFiles");

            if (!container) {
                return;
            }

            if (!taskId) {

                container.innerHTML =
                    '<span class="text-muted">No files attached</span>';

                return;
            }

            container.innerHTML = `
            <div class="text-muted text-center py-2">
                <div class="spinner-border spinner-border-sm me-2"></div>
                Loading files...
            </div>
        `;

            try {

                const response = await fetch(
                    `?handler=TaskFiles&taskId=${encodeURIComponent(taskId)}`
                );

                if (!response.ok) {
                    throw new Error(`TaskFiles request failed: ${response.status}`);
                }

                const files = await response.json();

                if (!Array.isArray(files) || files.length === 0) {

                    container.innerHTML =
                        '<span class="text-muted">No files attached</span>';

                    return;
                }

                container.innerHTML = "";

                files.forEach(function(file) {

                    const row = document.createElement("div");
                    row.className =
                        "d-flex align-items-center justify-content-between mb-2";

                    const info = document.createElement("div");

                    const link = document.createElement("a");
                    link.href = "/uploads/tasks/" + file.storedFileName;
                    link.target = "_blank";
                    link.rel = "noopener";
                    link.textContent = file.fileName;

                    info.appendChild(link);

                    if (file.fileSizeDisplay) {

                        const size = document.createElement("small");
                        size.className = "text-muted ms-2";
                        size.textContent = file.fileSizeDisplay;

                        info.appendChild(size);
                    }

                    const deleteWrapper = document.createElement("div");
                    deleteWrapper.className = "form-check";

                    const checkbox = document.createElement("input");
                    checkbox.type = "checkbox";
                    checkbox.className = "form-check-input";
                    checkbox.name = "DeleteFileIds";
                    checkbox.value = file.id;
                    checkbox.id = `deleteFile_${file.id}`;

                    const label = document.createElement("label");
                    label.className = "form-check-label text-danger small";
                    label.htmlFor = checkbox.id;
                    label.textContent = "Delete";

                    deleteWrapper.appendChild(checkbox);
                    deleteWrapper.appendChild(label);

                    row.appendChild(info);
                    row.appendChild(deleteWrapper);

                    container.appendChild(row);
                });

            }
            catch (error) {

                console.error("TaskFiles Error:", error);

                container.innerHTML =
                    '<span class="text-danger">Unable to load files.</span>';
            }
        }


        /* =====================================================
           MANAGE MEMBERS MODAL
           ===================================================== */

        const membersModal =
            document.getElementById(
                "manageMembersModal"
            );


        const manageProjectMembersContainer =
            document.getElementById(
                "manageProjectMembersContainer"
            );


        if (membersModal &&
            manageProjectMembersContainer) {

            membersModal.addEventListener(
                "show.bs.modal",
                async function(event) {

                    const button =
                        event.relatedTarget;


                    if (!button)
                        return;


                    /* =========================================
                       GET TASK INFORMATION
                       ========================================= */

                    const taskId =
                        button.getAttribute(
                            "data-id"
                        ) || "";


                    const taskName =
                        button.getAttribute(
                            "data-name"
                        ) || "";


                    const projectId =
                        button.getAttribute(
                            "data-project-id"
                        ) || "";


                    document.getElementById(
                        "memberTaskId"
                    ).value =
                        taskId;


                    document.getElementById(
                        "memberTaskName"
                    ).textContent =
                        taskName;


                    /* =========================================
                       LOADING STATE
                       ========================================= */

                    manageProjectMembersContainer.innerHTML = `
                                    <div class="text-muted text-center py-3">
                                        <div class="spinner-border spinner-border-sm me-2"></div>
                                        Loading project members...
                                    </div>
                                `;


                    /* =========================================
                       PROJECT ID CHECK
                       ========================================= */

                    if (!projectId) {

                        manageProjectMembersContainer.innerHTML = `
                                        <div class="text-danger text-center py-3">
                                            Project information not found for this task.
                                        </div>
                                    `;

                        return;
                    }


                    try {

                        /* =====================================
                           1. LOAD PROJECT MEMBERS
                           ===================================== */

                        const membersResponse =
                            await fetch(
                                `?handler=ProjectMembers&projectId=${encodeURIComponent(projectId)}`
                            );


                        if (!membersResponse.ok) {

                            throw new Error(
                                `ProjectMembers request failed: ${membersResponse.status}`
                            );

                        }


                        const projectMembers =
                            await membersResponse.json();


                        /* =====================================
                           2. LOAD CURRENT TASK MEMBERS
                           ===================================== */

                        const assignedResponse =
                            await fetch(
                                `?handler=TaskMembers&taskId=${encodeURIComponent(taskId)}`
                            );


                        if (!assignedResponse.ok) {

                            throw new Error(
                                `TaskMembers request failed: ${assignedResponse.status}`
                            );

                        }


                        const assignedMemberIds =
                            await assignedResponse.json();


                        const assignedIds =
                            Array.isArray(
                                assignedMemberIds
                            )
                                ? assignedMemberIds.map(
                                    id => Number(id)
                                )
                                : [];


                        /* =====================================
                           3. CLEAR CONTAINER
                           ===================================== */

                        manageProjectMembersContainer.innerHTML =
                            "";


                        /* =====================================
                           4. NO MEMBERS
                           ===================================== */

                        if (!Array.isArray(projectMembers) ||
                            projectMembers.length === 0) {

                            manageProjectMembersContainer.innerHTML = `
                                            <div class="text-muted text-center py-3">
                                                No members found in this project.
                                            </div>
                                        `;

                            return;
                        }


                        /* =====================================
                           5. CREATE CHECKBOXES
                           ===================================== */

                        projectMembers.forEach(
                            function(member) {

                                const wrapper =
                                    document.createElement(
                                        "div"
                                    );


                                wrapper.className =
                                    "form-check mb-2";


                                const checkbox =
                                    document.createElement(
                                        "input"
                                    );


                                checkbox.type =
                                    "checkbox";


                                checkbox.className =
                                    "form-check-input";


                                /*
                                 * IMPORTANT:
                                 * This name must match
                                 * List<int> AssignedToUserIds
                                 */
                                checkbox.name =
                                    "AssignedToUserIds";


                                checkbox.value =
                                    member.id;


                                checkbox.id =
                                    `manageTaskMember_${member.id}`;


                                /* =================================
                                   CHECK CURRENTLY ASSIGNED MEMBERS
                                   ================================= */

                                if (
                                    assignedIds.includes(
                                        Number(member.id)
                                    )
                                ) {

                                    checkbox.checked =
                                        true;

                                }


                                const label =
                                    document.createElement(
                                        "label"
                                    );


                                label.className =
                                    "form-check-label";


                                label.htmlFor =
                                    checkbox.id;


                                label.textContent =
                                    member.name ||
                                    "Unknown member";


                                wrapper.appendChild(
                                    checkbox
                                );


                                wrapper.appendChild(
                                    label
                                );


                                manageProjectMembersContainer.appendChild(
                                    wrapper
                                );

                            }
                        );

                    }
                    catch (error) {

                        console.error(
                            "Manage Members Error:",
                            error
                        );


                        manageProjectMembersContainer.innerHTML = `
                                        <div class="text-danger text-center py-3">
                                            Something went wrong while loading project members.
                                        </div>
                                    `;

                    }

                }
            );

        }


        /* =====================================================
           FILTER PANEL
           ===================================================== */

        const filterButton =
            document.getElementById(
                "filterButton"
            );


        const filterPanel =
            document.getElementById(
                "filterPanel"
            );


        if (filterButton &&
            filterPanel) {

            filterButton.addEventListener(
                "click",
                function(event) {

                    event.stopPropagation();


                    filterPanel.classList.toggle(
                        "show"
                    );


                    filterButton.classList.toggle(
                        "active"
                    );

                }
            );


            document.addEventListener(
                "click",
                function(event) {

                    if (
                        !filterPanel.contains(
                            event.target
                        ) &&
                        !filterButton.contains(
                            event.target
                        )
                    ) {

                        filterPanel.classList.remove(
                            "show"
                        );


                        filterButton.classList.remove(
                            "active"
                        );

                    }

                }
            );

        }


        /* =====================================================
           SEARCH
           ===================================================== */

        const searchInput =
            document.getElementById(
                "taskSearch"
            );


        function getTaskRows() {
            return Array.from(
                document.querySelectorAll(
                    ".task-row"
                )
            );
        }


        function applyTaskFilters() {

            const searchValue =
                (searchInput?.value || "")
                    .trim()
                    .toLowerCase();


            const statusValue =
                document.getElementById(
                    "statusFilter"
                )?.value || "";

            const projectFilter =
                (document.getElementById("projectFilter")?.value || "")
                    .toLowerCase();

            const memberFilter =
                (document.getElementById("memberFilter")?.value || "")
                    .toLowerCase();


            getTaskRows().forEach(
                function(row) {

                    const name =
                        (
                            row.getAttribute(
                                "data-task-name"
                            ) || ""
                        ).toLowerCase();


                    const project =
                        (
                            row.getAttribute(
                                "data-task-project"
                            ) || ""
                        ).toLowerCase();


                    const status =
                        (
                            row.getAttribute(
                                "data-task-status"
                            ) || ""
                        ).toLowerCase();


                    const matchesSearch =
                        name.includes(
                            searchValue
                        ) ||
                        project.includes(
                            searchValue
                        );


                    const rowMember =
                        (
                            row.getAttribute("data-task-member")
                            || ""
                        ).toLowerCase();


                    const matchesStatus =
                        !statusValue ||
                        status ===
                        statusValue.toLowerCase();


                    const matchesProject =
                        !projectFilter ||
                        project.includes(projectFilter);


                    const matchesMember =
                        !memberFilter ||
                        rowMember.includes(memberFilter);


                    row.style.display =
                        matchesSearch &&
                            matchesStatus &&
                            matchesProject &&
                            matchesMember
                            ? ""
                            : "none";

                }
            );

        }


        if (searchInput) {

            searchInput.addEventListener(
                "input",
                applyTaskFilters
            );

        }


        const projectFilter =
            document.getElementById("projectFilter");

        const memberFilter =
            document.getElementById("memberFilter");


        if (projectFilter) {

            projectFilter.addEventListener(
                "change",
                applyTaskFilters
            );

        }


        if (memberFilter) {

            memberFilter.addEventListener(
                "change",
                applyTaskFilters
            );

        }


        /* =====================================================
           CLEAR FILTER
           ===================================================== */

        const clearFilter =
            document.getElementById(
                "clearFilter"
            );


        if (clearFilter) {

            clearFilter.addEventListener(
                "click",
                function() {

                    if (searchInput) {
                        searchInput.value = "";
                    }


                    const statusFilter =
                        document.getElementById(
                            "statusFilter"
                        );


                    if (statusFilter) {
                        statusFilter.value = "";
                    }


                    $("#projectFilter")
                        .val("")
                        .trigger("change");


                    $("#memberFilter")
                        .val("")
                        .trigger("change");


                    applyTaskFilters();

                }
            );

        }


        /* =====================================================
           SORT
           ===================================================== */

        const sortSelect =
            document.getElementById(
                "sortTasks"
            );


        const tableBody =
            document.querySelector(
                "#table-main tbody"
            );


        if (sortSelect &&
            tableBody) {

            sortSelect.addEventListener(
                "change",
                function() {

                    const value =
                        sortSelect.value;


                    const parts =
                        value.split("-");


                    const field =
                        parts[0];


                    const direction =
                        parts[1];


                    const sortedRows =
                        Array.from(
                            tableBody.querySelectorAll(
                                ".task-row"
                            )
                        );


                    sortedRows.sort(
                        function(a, b) {

                            let aValue = "";
                            let bValue = "";


                            if (field === "name") {

                                aValue =
                                    a.getAttribute(
                                        "data-task-name"
                                    ) || "";


                                bValue =
                                    b.getAttribute(
                                        "data-task-name"
                                    ) || "";

                            }
                            else if (
                                field === "status"
                            ) {

                                aValue =
                                    a.getAttribute(
                                        "data-task-status"
                                    ) || "";


                                bValue =
                                    b.getAttribute(
                                        "data-task-status"
                                    ) || "";

                            }
                            else if (
                                field === "priority"
                            ) {

                                aValue =
                                    a.getAttribute(
                                        "data-task-priority"
                                    ) || "";


                                bValue =
                                    b.getAttribute(
                                        "data-task-priority"
                                    ) || "";

                            }
                            else if (
                                field === "due"
                            ) {

                                aValue =
                                    a.getAttribute(
                                        "data-task-due"
                                    ) || "";


                                bValue =
                                    b.getAttribute(
                                        "data-task-due"
                                    ) || "";

                            }


                            aValue =
                                aValue.toLowerCase();


                            bValue =
                                bValue.toLowerCase();


                            let result =
                                aValue.localeCompare(
                                    bValue,
                                    undefined,
                                    {
                                        numeric: true,
                                        sensitivity: "base"
                                    }
                                );


                            return direction === "desc"
                                ? -result
                                : result;

                        }
                    );


                    sortedRows.forEach(
                        function(row) {

                            tableBody.appendChild(
                                row
                            );

                        }
                    );

                }
            );

        }

    });
    $(document).ready(function() {


        $(".select-search").select2({

            width: "220px",

            placeholder: "Select",

            allowClear: true

        });



    });
    /* =====================================================
    TRANSFER TASK MODAL
    ===================================================== */

    const transferModal =
        document.getElementById("transferTaskModal");

    const transferFromSelect =
        document.getElementById("transferFromUser");

    const transferToSelect =
        document.getElementById("transferToUser");

    const transferHistoryList =
        document.getElementById("transferHistoryList");


    if (transferModal &&
        transferFromSelect &&
        transferToSelect) {

        transferModal.addEventListener(
            "show.bs.modal",
            async function(event) {

                const button = event.relatedTarget;

                if (!button) {
                    return;
                }

                const taskId =
                    button.getAttribute("data-id") || "";

                const taskName =
                    button.getAttribute("data-name") || "";

                const projectId =
                    button.getAttribute("data-project-id") || "";

                document.getElementById("transferTaskId").value = taskId;
                document.getElementById("transferTaskName").textContent = taskName;
                document.getElementById("transferNote").value = "";

                transferFromSelect.innerHTML =
                    '<option value="">Loading...</option>';

                transferToSelect.innerHTML =
                    '<option value="">Loading...</option>';

                transferHistoryList.innerHTML = `
                    <div class="text-muted text-center py-2">
                        <div class="spinner-border spinner-border-sm me-2"></div>
                        Loading...
                    </div>
                `;

                if (!projectId) {

                    transferFromSelect.innerHTML =
                        '<option value="">No project found</option>';

                    transferToSelect.innerHTML =
                        '<option value="">No project found</option>';

                    return;
                }

                try {

                    const [projectMembersResp, taskMemberIdsResp, historyResp] =
                        await Promise.all([
                            fetch(`?handler=ProjectMembers&projectId=${encodeURIComponent(projectId)}`),
                            fetch(`?handler=TaskMembers&taskId=${encodeURIComponent(taskId)}`),
                            fetch(`?handler=TaskTransferHistory&taskId=${encodeURIComponent(taskId)}`)
                        ]);

                    const projectMembers =
                        projectMembersResp.ok ? await projectMembersResp.json() : [];

                    const taskMemberIds =
                        taskMemberIdsResp.ok ? await taskMemberIdsResp.json() : [];

                    const history =
                        historyResp.ok ? await historyResp.json() : [];

                    const taskMemberIdSet =
                        new Set(
                            (Array.isArray(taskMemberIds) ? taskMemberIds : [])
                                .map(id => Number(id))
                        );

                    /* -------- FROM: only members currently on the task -------- */

                    transferFromSelect.innerHTML =
                        '<option value="">-- Select current member --</option>';

                    projectMembers
                        .filter(m => taskMemberIdSet.has(Number(m.id)))
                        .forEach(function(member) {

                            const option = document.createElement("option");
                            option.value = member.id;
                            option.textContent = member.name || "Unknown member";

                            transferFromSelect.appendChild(option);
                        });

                    /* -------- TO: any project member -------- */

                    transferToSelect.innerHTML =
                        '<option value="">-- Select project member --</option>';

                    projectMembers.forEach(function(member) {

                        const option = document.createElement("option");
                        option.value = member.id;
                        option.textContent = member.name || "Unknown member";

                        transferToSelect.appendChild(option);
                    });

                    /* -------- HISTORY -------- */

                    if (!Array.isArray(history) || history.length === 0) {

                        transferHistoryList.innerHTML =
                            '<div class="text-muted text-center py-2">No transfer history yet.</div>';
                    }
                    else {

                        transferHistoryList.innerHTML = "";

                        history.forEach(function(entry) {

                            const item = document.createElement("div");
                            item.className = "mb-2 pb-2 border-bottom";

                            const line1 = document.createElement("div");

                            const strongFrom = document.createElement("strong");
                            strongFrom.textContent = entry.fromUserName;

                            const arrow = document.createTextNode(" \u2192 ");

                            const strongTo = document.createElement("strong");
                            strongTo.textContent = entry.toUserName;

                            const dateSmall = document.createElement("small");
                            dateSmall.className = "text-muted ms-1";
                            dateSmall.textContent = entry.transferredAt;

                            line1.appendChild(strongFrom);
                            line1.appendChild(arrow);
                            line1.appendChild(strongTo);
                            line1.appendChild(dateSmall);

                            const noteLine = document.createElement("div");
                            noteLine.className = "text-muted small";
                            noteLine.textContent = entry.note;

                            const byLine = document.createElement("div");
                            byLine.className = "text-muted small";
                            byLine.textContent = "By " + entry.transferredByUserName;

                            item.appendChild(line1);
                            item.appendChild(noteLine);
                            item.appendChild(byLine);

                            transferHistoryList.appendChild(item);
                        });
                    }

                }
                catch (error) {

                    console.error("Transfer modal load error:", error);

                    transferFromSelect.innerHTML =
                        '<option value="">Error loading members</option>';

                    transferToSelect.innerHTML =
                        '<option value="">Error loading members</option>';

                    transferHistoryList.innerHTML =
                        '<div class="text-danger text-center py-2">Unable to load history.</div>';
                }
            }
        );

        // Prevent picking the same person for both From and To
        transferFromSelect.addEventListener("change", function() {

            Array.from(transferToSelect.options).forEach(function(opt) {
                opt.disabled =
                    opt.value !== "" &&
                    opt.value === transferFromSelect.value;
            });
        });
    }

</script>
}