<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TaskTracker</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TaskTracker.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Style.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet"href="https://cdn.datatables.net/2.3.4/css/dataTables.dataTables.min.css" />
</head>
@if (User.Identity?.IsAuthenticated == true)
{
    var currentUserIdClaim =
        User.FindFirstValue(ClaimTypes.NameIdentifier);

    int currentUserId = 0;

    if (!string.IsNullOrEmpty(currentUserIdClaim))
    {
        int.TryParse(currentUserIdClaim, out currentUserId);
    }

    var notificationsResult =
        currentUserId > 0
            ? await NotificationService.GetForUserAsync(currentUserId)
            : null;

    var notifications =
        notificationsResult?.Succeeded == true
            ? notificationsResult.Value
            : Array.Empty<NotificationDto>();


    <div class="modal fade"
         id="notificationModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">

            <div class="modal-content rounded-4 border-0 shadow">

                <div class="modal-header">

                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-bell me-2"></i>
                        Notifications
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body p-0">

                    @if (notifications.Any())
                    {
                        <div class="list-group list-group-flush">

                            @foreach (var notification in notifications)
                            {
                                <div class="list-group-item
                                    @(notification.IsRead
                                         ? ""
                                         : "notification-unread")">

                                    <div class="d-flex gap-3">

                                        <div class="notification-icon">

                                            @switch (notification.Type)
                                            {
                                                case TaskTrackerDAL.Models.Enums.NotificationType.TaskAssigned:
                                                    <i class="bi bi-clipboard-check"></i>
                                                    break;

                                                case TaskTrackerDAL.Models.Enums.NotificationType.TaskCompleted:
                                                    <i class="bi bi-check-circle"></i>
                                                    break;

                                                case TaskTrackerDAL.Models.Enums.NotificationType.ProjectCreated:
                                                    <i class="bi bi-folder-plus"></i>
                                                    break;

                                                case TaskTrackerDAL.Models.Enums.NotificationType.DeadlineToday:
                                                    <i class="bi bi-exclamation-circle"></i>
                                                    break;

                                                case TaskTrackerDAL.Models.Enums.NotificationType.DeadlineTomorrow:
                                                    <i class="bi bi-clock"></i>
                                                    break;

                                                default:
                                                    <i class="bi bi-bell"></i>
                                                    break;
                                            }

                                        </div>


                                        <div class="flex-grow-1">

                                            <div class="fw-semibold">
                                                @notification.Message
                                            </div>

                                            <small class="text-muted">
                                                @notification.CreatedAt.ToLocalTime()
                                                
                                            </small>

                                        </div>


                                        @if (!notification.IsRead)
                                        {
                                            <span class="unread-dot"></span>
                                        }

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">

                            <i class="bi bi-bell-slash fs-1 text-muted"></i>

                            <p class="text-muted mt-3 mb-0">
                                No notifications yet.
                            </p>

                        </div>
                    }

                </div>


                <div class="modal-footer">

                    <a asp-page="/Notifications/Index"
                       class="btn btn-outline-primary">

                        View All Notifications

                    </a>

                </div>

            </div>

        </div>

    </div>
}
