@using TaskTrackerDAL.Constants
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TaskTracker</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TaskTracker.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Style.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <header>
        <div class="wrapper">
            <nav class="navbar navbar-expand-lg">
                <!--Logo-->
                <a asp-page="Dashboard/Index" class="logo">
                    <img src="~/images/logo/TTlogo.png" />
                </a>

                

                <!--Menu items-->
                @if (!User.IsInRole(AppRoles.Admin) && !User.IsInRole(AppRoles.Manager))
                    {
                        <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" asp-page="/Dashboard/Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/About">About</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Contact">Contact</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Faqs">FAQs</a></li>
                </ul>
                
                
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link login-link" asp-page="/Account/Login">Login</a>
                    </li>
                </ul>
                }
                @if(User.IsInRole(AppRoles.Admin))
                {
                    <ul class="navbar-nav">
                        <li class="nav-item"><a class="nav-link" asp-page="/Dashboard/Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Companies/Index">Companies</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="">Projects</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Employees/Index">Employees</a></li>
                    </ul>

                
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link login-link" asp-page="/Account/Logout">Logout</a>
                        </li>
                    </ul>
                }
                

            </nav>

        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - TaskTracker - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    
</body>
</html>
