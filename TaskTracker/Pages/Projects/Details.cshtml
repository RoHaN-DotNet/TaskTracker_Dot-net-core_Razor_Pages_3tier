@page "{id:int}"
@model TaskTracker.Pages.Projects.DetailsModel
@{
    ViewData["Title"] = "Project Details";
}

<h1>@Model.Project.Name</h1>

<dl class="row">
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Project.Status</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Project.Description</dd>

    <dt class="col-sm-3">Start Date</dt>
    <dd class="col-sm-9">@Model.Project.StartDate.ToString("d")</dd>

    <dt class="col-sm-3">End Date</dt>
    <dd class="col-sm-9">@(Model.Project.EndDate?.ToString("d") ?? "—")</dd>

    <dt class="col-sm-3">Created By</dt>
    <dd class="col-sm-9">@Model.Project.CreatedByUserName</dd>

    <dt class="col-sm-3">Progress</dt>
    <dd class="col-sm-9">@Model.Project.CompletedTasks / @Model.Project.TotalTasks tasks completed</dd>

    <dt class="col-sm-3">Team Size</dt>
    <dd class="col-sm-9">@Model.Project.TeamMemberCount</dd>
</dl>

@if (Model.CanManage)
{
    <div class="mb-4">
        <a asp-page="/Projects/Edit" asp-route-id="@Model.Project.Id" class="btn btn-secondary">Edit</a>

        @if (Model.Project.Status != CompanyManagementSystem.Core.Enums.ProjectStatus.Archived)
        {
            <form method="post" asp-page="/Projects/Archive" asp-route-id="@Model.Project.Id" class="d-inline">
                <button type="submit" class="btn btn-warning"
                        onclick="return confirm('Archive this project?');">
                    Archive
                </button>
            </form>
        }
    </div>

    <h3>Assign Employee</h3>
    <form method="post" asp-page="/Projects/AssignMember">
        <input type="hidden" name="ProjectId" value="@Model.Project.Id" />
        <div class="row g-2">
            <div class="col-auto">
                <select name="UserId" class="form-select">
                    <option value="">-- Select Employee --</option>
                    @foreach (var employee in Model.AssignableEmployees)
                    {
                        <option value="@employee.Id">@employee.FullName</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Assign</button>
            </div>
        </div>
    </form>
}
