@page
@model TaskTracker.Pages.Projects.IndexModel
@{
    ViewData["Title"] = "Projects";
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}
@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["WarningMessage"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}
@if (TempData["InfoMessage"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @TempData["InfoMessage"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}
@if (Model.IsEmployeeView)
{
    <p class="text-muted">Showing projects you are assigned to.</p>

    @if (Model.AssignedProjects.Count == 0)
    {
        <p>You are not currently assigned to any projects.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Tasks</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var project in Model.AssignedProjects)
                {
                    <tr>
                        <td>@project.Name</td>
                        <td>@project.Status</td>
                        <td>@project.CompletedTasks / @project.TotalTasks</td>
                        <td>
                            <a asp-page="/Projects/Details" asp-route-id="@project.Id" class="btn btn-sm btn-outline-primary">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
else if(Model.CanManage||Model.IsAdmin)
{   
    <div class="d-flex justify-content-between mt-lg-5">
        <div>
            <h1>Projects</h1>
        </div>
        <div>
            @if(Model.CanManage)
            {
            <div class="d-flex justify-content-between align-items-center mb-3">      
                <button type="button"
                            class="btn-custom btn-primary "
                            data-bs-toggle="modal"
                            data-bs-target="#createModal">
                        <i class="bi bi-plus-circle"></i>
                        Add Project
                </button>
            </div>
            }
        </div>
    </div>
   

    <form method="get" class="row g-2 mb-4">
        <div class="d-flex justify-content-end style=" width:300px"">
            <select asp-for="Filter.Status" class="form-select">
                <option value="">All Statuses</option>
                @foreach (var status in Enum.GetValues<TaskTrackerDAL.Models.Enums.ProjectStatus>())
                {
                    <option value="@((int)status)">@status</option>
                }
            </select>
        </div>
        <input type="hidden" asp-for="Filter.PageNumber" value="1" />
    </form>

    @if (Model.PagedProjects is null)
    {
        <p class="text-danger">Unable to load projects.</p>
    }
    else if (Model.PagedProjects.Items.Count == 0)
    {
        <p>No projects match your search.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>
                        <form method="get" class="row g-2">
                            <div style="width:300px">
                                <input asp-for="Filter.SearchTerm" class="form-control" placeholder="Search by name" style="width:300px" />
                            </div>
                        </form>
                    </th>
                    <th>Status</th>
                    <th>Team</th>
                    <th>Tasks</th>
                    @if (Model.CanManage)
                    {
                    <th>Actions</th>
                    <th>Manage Member</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var project in Model.PagedProjects.Items)
                {
                    <tr>
                        <td style="width:400px;">@project.Name</td>
                        <td>@project.Status</td>
                        <td>@project.TeamMemberCount</td>
                        <td>@project.CompletedTasks / @project.TotalTasks</td>
                        @if (Model.CanManage)
                        {
                        <td>
                            <div class="d-flex justify-content-start gap-2">
                                <button class="btn btn-sm btn-outline-secondary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editModal"
                                        data-id="@project.Id"
                                        data-name="@project.Name"
                                        data-description="@project.Description"
                                        data-status="@((int)project.Status)"
                                        data-startdate="@project.StartDate.ToString("yyyy-MM-dd")"
                                        data-enddate="@(project.EndDate?.ToString("yyyy-MM-dd"))">

                                    <i class="bi bi-pencil-square"></i>

                                </button>
                            </div>
                        </td>
                        
                        <td>
                            <div class="justify-content-start">
                                <button class="btn btn-outline-success border-0 manage-member-btn"
                                        data-id="@project.Id"
                                        data-name="@project.Name"
                                        data-members="@string.Join(",", project.Members.Select(x => x.UserId))">
                                    Manage
                                </button>
                            </div>
                        </td>
                        }
                    </tr>
                }
            </tbody>
        </table>

        <nav>
            <ul class="pagination">
                <li class="page-item @(Model.PagedProjects.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" asp-page="/Projects/Index"
                       asp-route-Filter.SearchTerm="@Model.Filter.SearchTerm"
                       asp-route-Filter.Status="@Model.Filter.Status"
                       asp-route-Filter.PageNumber="@(Model.PagedProjects.PageNumber - 1)">Previous</a>
                </li>
                @for (var p = 1; p <= Model.PagedProjects.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PagedProjects.PageNumber ? "active" : "")">
                        <a class="page-link" asp-page="/Projects/Index"
                           asp-route-Filter.SearchTerm="@Model.Filter.SearchTerm"
                           asp-route-Filter.Status="@Model.Filter.Status"
                           asp-route-Filter.PageNumber="@p">@p</a>
                    </li>
                }
                <li class="page-item @(Model.PagedProjects.HasNextPage ? "" : "disabled")">
                    <a class="page-link" asp-page="/Projects/Index"
                       asp-route-Filter.SearchTerm="@Model.Filter.SearchTerm"
                       asp-route-Filter.Status="@Model.Filter.Status"
                       asp-route-Filter.PageNumber="@(Model.PagedProjects.PageNumber + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
    <!--Edit Project Modal-->
    <div class="modal fade" id="editModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Edit Project</h4>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>
                <form method="post" asp-page-handler="Edit">
                    <div class="modal-body">
                        <input asp-for="updateProject.Id"
                               type="hidden"
                               id="Id" />
                        <div class="mb-3">
                            <label asp-for="updateProject.Name" class="form-label"></label>
                            <input asp-for="updateProject.Name"
                                   class="form-control"
                                   id="projectName" />
                            <span asp-validation-for="updateProject.Name"
                                  class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="updateProject.Description" class="form-label"></label>
                            <textarea asp-for="updateProject.Description"
                                      class="form-control"
                                      rows="3"
                                      id="projectDescription"></textarea>
                            <span asp-validation-for="updateProject.Description"
                                  class="text-danger"></span>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="updateProject.StartDate" class="form-label"></label>
                                <input asp-for="updateProject.StartDate"
                                       type="date"
                                       class="form-control"
                                       id="startDate" />
                                <span asp-validation-for="updateProject.StartDate"
                                      class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="updateProject.EndDate" class="form-label"></label>
                                <input asp-for="updateProject.EndDate"
                                       type="date"
                                       class="form-control"
                                       id="endDate" />
                                <span asp-validation-for="updateProject.EndDate"
                                      class="text-danger"></span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="updateProject.Status" class="form-label"></label>
                            <select asp-for="updateProject.Status"
                                    asp-items="Model.StatusOptions"
                                    class="form-select"
                                    id="projectStatus">
                            </select>
                            <span asp-validation-for="updateProject.Status"
                                  class="text-danger"></span>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit"
                                class="btn btn-primary">
                            Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!--Create Project Modal-->
    <div class="modal fade" id="createModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">
                    <h4>Create Project</h4>
                    <button class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>
                <form method="post"
                      asp-page-handler="Create">
                    <div class="modal-body">
                        <input asp-for="createProject.CompanyId"
                               type="hidden" />
                        <div class="mb-3">
                            <label asp-for="createProject.Name"></label>
                            <input asp-for="createProject.Name"
                                   class="form-control" />
                            <span asp-validation-for="createProject.Name"
                                  class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="createProject.Description"></label>
                            <textarea asp-for="createProject.Description"
                                      rows="3"
                                      class="form-control">
                        </textarea>
                            <span asp-validation-for="createProject.Description"
                                  class="text-danger"></span>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <label asp-for="createProject.StartDate"></label>
                                <input asp-for="createProject.StartDate"
                                       type="date"
                                       class="form-control" />
                                <span asp-validation-for="createProject.StartDate"
                                      class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="createProject.EndDate"></label>
                                <input asp-for="createProject.EndDate" type="date"class="form-control" />
                                <span asp-validation-for="createProject.EndDate"
                                      class="text-danger"></span>
                            </div>
                        </div>
                        <div class="mt-3">
                            <label class="form-label fw-bold">Team Members</label>
                            <div class="border rounded-3 p-3" style="max-height:350px; overflow-y:auto;">
                                @foreach (var employee in Model.AllEmployees)
                                {
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" name="createProject.InitialMemberUserIds" value="@employee.Id" id="create_emp_@employee.Id" />
                                        <label class="form-check-label" for="create_emp_@employee.Id">
                                            <strong>@employee.FullName</strong>
                                            <span class="text-secondary">
                                                [@string.Join(", ", employee.Roles)]
                                            </span>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button class="btn btn-primary" type="submit">Create</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!--Add or Remove Member Modal-->
    <div class="modal fade" id="editMemberModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Manage Project Memeber</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" asp-page-handler="AddOrRemoveMember">
                    <div class="modal-body">
                        <input asp-for="updateMember.ProjectId" type="hidden" id="ProjectId" />
                        <div class="mb-3">
                            <label class="form-label fw-bold">Project Name</label>
                            <input id="ProjectName" class="form-control"readonly />
                        </div>
                        <hr/>
                        <h6>Members</h6>
                        <div class="border rounded-3" style="max-height:350px; overflow-y:auto;">
                            @foreach (var employee in Model.AllEmployees)
                                {
                                    <div class="form-check mb-2">
                                        <input type="checkbox" class="form-check-input member-checkbox" name="updateMember.MemberUserIds" value="@employee.Id" id="emp_@employee.Id" />
                                        <label class="form-check-label" for="emp_@employee.Id">
                                            <strong>@employee.FullName</strong>
                                            <span class="text-secondary">
                                                [@string.Join(", ", employee.Roles)]
                                            </span>
                                        </label>
                                    </div>
                                }
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
@section Scripts{
    <script>
        const editModal = document.getElementById('editModal');

        editModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;

            document.getElementById("Id").value =
                button.getAttribute("data-id");

            document.getElementById("projectName").value =
                button.getAttribute("data-name");

            document.getElementById("projectDescription").value =
                button.getAttribute("data-description");

            document.getElementById("projectStatus").value =
                button.getAttribute("data-status");

            document.getElementById("startDate").value =
                button.getAttribute("data-startdate");

            document.getElementById("endDate").value =
                button.getAttribute("data-enddate");
        });
        //Update Project Members
        $(document).on("click", ".manage-member-btn", function () {

            const projectId = $(this).data("id");
            const projectName = $(this).data("name");

            $("#ProjectId").val(projectId);
            $("#ProjectName").val(projectName);

            $(".member-checkbox").prop("checked", false);

            const members = $(this).data("members");

            if (members) {

                members.toString().split(',').forEach(function (id) {

                    $("#emp_" + id).prop("checked", true);

                });

            }

            const modal = new bootstrap.Modal(document.getElementById("editMemberModal"));
            modal.show();
        });

    </script>


}