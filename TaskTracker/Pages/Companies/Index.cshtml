@page
@model TaskTracker.Pages.Companies.IndexModel
@{
    ViewData["Title"] = "Companies";
}
<div class="d-flex justify-content-between mt-lg-3">
    <div>
        <h1>Companies</h1>
    </div>
    <div class="ps-md-2">
        <form method="get" id="searchForm" class="column-gap-2 m-2">
           <div class="">
              <select asp-for="Filter.IsActive" class="form-select">
              <option value="">All Statuses</option>
              <option value="true">Active</option>
              <option value="false">Inactive</option>
              </select>
           </div>
           <input type="hidden" asp-for="Filter.PageNumber" value="1" />
        </form>
    </div>
</div>
<table class="table table-striped">
        <thead>
            <tr>
                <th>
                    <form method="get" id="searchForm" class="column-gap-2">
                        <div class="col-auto">
                            <input asp-for="Filter.SearchTerm" id="searchBox"class="form-control"placeholder="Search name or email" />
                        </div>
                        <input type="hidden" asp-for="Filter.PageNumber" value="1" />
                    </form>
                </th>
                <th>Email</th>
                <th>Users</th>
                <th>Projects</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>

@if (Model.Result is null)
{
    <p class="text-danger">Unable to load companies.</p>
}
else if (Model.Result.Items.Count == 0)
{
    <p>No companies match your search.</p>
}
else
{
     <tbody>
            @foreach (var company in Model.Result.Items)
            {
                <tr>
                    <td>@company.Name</td>
                    <td>@company.Email</td>
                    <td>@company.TotalUsers</td>
                    <td>@company.TotalProjects</td>
                    <td>
                        @if (company.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>
                        <a asp-page="/Companies/Details" asp-route-id="@company.Id" class="btn btn-sm btn-outline-primary">Details</a>
                        <a asp-page="/Companies/Edit" asp-route-id="@company.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
}
</table>

    <nav>
        <ul class="pagination">
            <li class="page-item @(Model.Result.HasPreviousPage ? "" : "disabled")">
                <a class="page-link"
                   asp-page="/Companies/Index"
                   asp-route-Filter.SearchTerm="@Model.Filter.SearchTerm"
                   asp-route-Filter.IsActive="@Model.Filter.IsActive"
                   asp-route-Filter.PageNumber="@(Model.Result.PageNumber - 1)">
                    Previous
                </a>
            </li>
            @for (var p = 1; p <= Model.Result.TotalPages; p++)//p=page
            {
                <li class="page-item @(p == Model.Result.PageNumber ? "active" : "")">
                    <a class="page-link"
                       asp-page="/Companies/Index"
                       asp-route-Filter.SearchTerm="@Model.Filter.SearchTerm"
                       asp-route-Filter.IsActive="@Model.Filter.IsActive"
                       asp-route-Filter.PageNumber="@p">
                       @p
                        
                    </a>
                </li>
            }
            <li class="page-item @(Model.Result.HasNextPage ? "" : "disabled")">
                <a class="page-link"
                   asp-page="/Companies/Index"
                   asp-route-Filter.SearchTerm="@Model.Filter.SearchTerm"
                   asp-route-Filter.IsActive="@Model.Filter.IsActive"
                   asp-route-Filter.PageNumber="@(Model.Result.PageNumber + 1)">
                    Next
                </a>
            </li>
            
        </ul>
    </nav>
    <div class="d-flex justify-content-end mb-3">
    <a asp-page="/Companies/Create" class="btn btn-primary">
        Create Company
    </a>
    </div>
    
@section Scripts
{
    <script>
        let timer;

        const form = document.getElementById("searchForm");
        const searchBox = document.getElementById("searchBox");
        const status = document.querySelector("select[name='Filter.IsActive']");

        searchBox.addEventListener("input", function () {
            clearTimeout(timer);
            timer = setTimeout(() => form.submit(), 1000);
        });

        status.addEventListener("change", function () {
            form.submit();
        });
    </script>
}

 
