@page
@model TaskTracker.Pages.Companies.IndexModel

@{
    ViewData["Title"] = "Companies";
}

<link rel="stylesheet" href="~/css/companies.css" />

<div class="companies-page">

    <!-- ========================================================= -->
    <!-- PAGE HEADER -->
    <!-- ========================================================= -->

    <div class="page-header">

        <div>
            <h1>Company List</h1>

            <p>
                Manage your companies and their information
            </p>
        </div>

        <button type="button"
                class="btn-add"
                data-bs-toggle="modal"
                data-bs-target="#createCompanyModal">

            <span class="plus-icon">+</span>

            Add Company

        </button>

    </div>


    <!-- ========================================================= -->
    <!-- COMPANY CARD -->
    <!-- ========================================================= -->

    <div class="company-card">

        <!-- ===================================================== -->
        <!-- SEARCH / FILTER / SORT -->
        <!-- ===================================================== -->

        <div class="table-toolbar">

            <!-- SEARCH -->

            <form method="get"
                  id="searchForm">

                <div class="search-wrapper">

                    <span class="search-icon">
                        ⌕
                    </span>

                    <input asp-for="Filter.SearchTerm"
                           id="searchBox"
                           class="search-input"
                           placeholder="Search companies..." />

                    <input type="hidden"
                           name="Filter.PageNumber"
                           value="1" />

                    <input type="hidden"
                           name="Filter.PageSize"
                           value="@Model.Filter.PageSize" />

                </div>

            </form>


            <!-- RIGHT SIDE -->

            <div class="toolbar-right">

                <!-- STATUS FILTER -->

                <div class="filter-wrapper">

                    <span class="filter-label">
                        Filter
                    </span>

                    <select asp-for="Filter.IsActive"
                            id="statusFilter"
                            class="filter-select">

                        <option value="">
                            All Statuses
                        </option>

                        <option value="true">
                            Active
                        </option>

                        <option value="false">
                            Inactive
                        </option>

                    </select>

                </div>


                <!-- SORT -->

                <div class="sort-wrapper">

                    <span>
                        Sort by
                    </span>

                    <select id="sortSelect"
                            class="sort-select">

                        <option value="name">
                            Name ↑
                        </option>

                        <option value="name-desc">
                            Name ↓
                        </option>

                    </select>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- TABLE -->
        <!-- ===================================================== -->
        @if (Model.Result is null)
        {
            <div class="empty-message text-danger">
                Unable to load companies.
            </div>
        }
        else if (Model.Result.Items.Count == 0)
        {
            <div class="empty-message">
                No companies match your search.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="company-table">

                    <thead>

                        <tr>

                            <th>
                                Company
                            </th>

                            <th>
                                Email
                            </th>

                            <th>
                                Users
                            </th>

                            <th>
                                Projects
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="action-column">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var company in Model.Result.Items)
                        {
                            <tr class="company-row"
                                data-name="@company.Name">

                                <!-- ================================= -->
                                <!-- COMPANY -->
                                <!-- ================================= -->

                                <td>

                                    <div class="company-info">

                                        <div class="company-avatar">

                                            @(string.IsNullOrWhiteSpace(company.Name)
                                                ? "?"
                                                : company.Name.Substring(0, 1).ToUpper())

                                        </div>


                                        <div>

                                            <div class="company-name">
                                                @company.Name
                                            </div>

                                            <div class="company-subtitle">
                                                Company ID: @company.Id
                                            </div>

                                        </div>

                                    </div>

                                </td>


                                <!-- ================================= -->
                                <!-- EMAIL -->
                                <!-- ================================= -->

                                <td>

                                    <span class="company-email">

                                        @(string.IsNullOrWhiteSpace(company.Email)
                                            ? "-"
                                            : company.Email)

                                    </span>

                                </td>


                                <!-- ================================= -->
                                <!-- USERS -->
                                <!-- ================================= -->

                                <td>

                                    <span class="count-text">
                                        @company.TotalUsers
                                    </span>

                                </td>


                                <!-- ================================= -->
                                <!-- PROJECTS -->
                                <!-- ================================= -->

                                <td>

                                    <span class="count-text">
                                        @company.TotalProjects
                                    </span>

                                </td>


                                <!-- ================================= -->
                                <!-- STATUS -->
                                <!-- ================================= -->

                                <td>

                                    @if (company.IsActive)
                                    {
                                        <span class="status-badge active">

                                            <span class="status-dot"></span>

                                            Active

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge inactive">

                                            <span class="status-dot"></span>

                                            Inactive

                                        </span>
                                    }

                                </td>


                                <!-- ================================= -->
                                <!-- ACTION -->
                                <!-- ================================= -->

                                <td>

                                    <div class="action-buttons">

                                        <!-- DETAILS -->

                                        <button type="button"
                                                class="action-btn details-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#detailsCompanyModal"
                                                data-id="@company.Id"
                                                data-name="@company.Name"
                                                data-email="@company.Email"
                                                data-phone="@company.Phone"
                                                data-address="@company.Address"
                                                data-users="@company.TotalUsers"
                                                data-projects="@company.TotalProjects"
                                                data-active="@(company.IsActive ? "true" : "false")">

                                            Details

                                        </button>


                                        <!-- EDIT -->

                                        <button type="button"
                                                class="action-btn edit-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editCompanyModal"
                                                data-id="@company.Id"
                                                data-name="@company.Name"
                                                data-email="@company.Email"
                                                data-phone="@company.Phone"
                                                data-address="@company.Address"
                                                data-active="@(company.IsActive ? "true" : "false")">

                                            Edit

                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- ===================================================== -->
            <!-- PAGINATION -->
            <!-- ===================================================== -->

            <div class="table-footer">

                <div class="showing-text">

                    @if (Model.Result.TotalCount > 0)
                    {
                        <text>
                            Showing
                            @(
                                ((Model.Result.PageNumber - 1)
                                * Model.Result.PageSize) + 1
                            )
                            to
                            @(
                                Math.Min(
                                    Model.Result.PageNumber
                                    * Model.Result.PageSize,
                                    Model.Result.TotalCount
                                )
                            )
                            of
                            @Model.Result.TotalCount
                            companies
                        </text>
                    }
                    else
                    {
                        <text>
                            Showing 0 companies
                        </text>
                    }

                </div>


                <nav>

                    <ul class="pagination company-pagination">

                        <!-- PREVIOUS -->

                        <li class="page-item @(Model.Result.HasPreviousPage ? "" : "disabled")">

                            @if (Model.Result.HasPreviousPage)
                            {
                                <a class="page-link"
                                   asp-page="/Companies/Index"
                                   asp-route-Filter.SearchTerm="@Model.Filter.SearchTerm"
                                   asp-route-Filter.IsActive="@Model.Filter.IsActive"
                                   asp-route-Filter.PageSize="@Model.Filter.PageSize"
                                   asp-route-Filter.PageNumber="@(Model.Result.PageNumber - 1)">

                                    ‹

                                </a>
                            }
                            else
                            {
                                <span class="page-link">
                                    ‹
                                </span>
                            }

                        </li>


                        <!-- PAGE NUMBERS -->
                        @for (var p = 1; p <= Model.Result.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.Result.PageNumber ? "active" : "")">

                                <a class="page-link"
                                   asp-page="/Companies/Index"
                                   asp-route-Filter.SearchTerm="@Model.Filter.SearchTerm"
                                   asp-route-Filter.IsActive="@Model.Filter.IsActive"
                                   asp-route-Filter.PageSize="@Model.Filter.PageSize"
                                   asp-route-Filter.PageNumber="@p">

                                    @p

                                </a>

                            </li>
                        }


                        <!-- NEXT -->

                        <li class="page-item @(Model.Result.HasNextPage ? "" : "disabled")">

                            @if (Model.Result.HasNextPage)
                            {
                                <a class="page-link"
                                   asp-page="/Companies/Index"
                                   asp-route-Filter.SearchTerm="@Model.Filter.SearchTerm"
                                   asp-route-Filter.IsActive="@Model.Filter.IsActive"
                                   asp-route-Filter.PageSize="@Model.Filter.PageSize"
                                   asp-route-Filter.PageNumber="@(Model.Result.PageNumber + 1)">

                                    ›

                                </a>
                            }
                            else
                            {
                                <span class="page-link">
                                    ›
                                </span>
                            }

                        </li>

                    </ul>

                </nav>

            </div>
        }

    </div>

</div>


<!-- ============================================================= -->
<!-- CREATE COMPANY MODAL -->
<!-- ============================================================= -->

<div class="modal fade"
     id="createCompanyModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content company-modal">

            <!-- HEADER -->

            <div class="modal-header">

                <div>

                    <h5 class="modal-title">
                        Add Company
                    </h5>

                    <p class="modal-subtitle">
                        Create a new company
                    </p>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <!-- FORM -->

            <form method="post"
                  asp-page-handler="Create">

                <div class="modal-body">

                    <!-- VALIDATION SUMMARY -->

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <!-- COMPANY NAME -->

                    <div class="form-group">

                        <label asp-for="CreateCompany.Name">
                            Company Name
                        </label>

                        <input asp-for="CreateCompany.Name"
                               class="form-control"
                               placeholder="Enter company name" />

                        <span asp-validation-for="CreateCompany.Name"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- EMAIL -->

                    <div class="form-group">

                        <label asp-for="CreateCompany.Email">
                            Email
                        </label>

                        <input asp-for="CreateCompany.Email"
                               type="email"
                               class="form-control"
                               placeholder="company@example.com" />

                        <span asp-validation-for="CreateCompany.Email"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- PHONE -->

                    <div class="form-group">

                        <label asp-for="CreateCompany.Phone">
                            Contact Number
                        </label>

                        <input asp-for="CreateCompany.Phone"
                               class="form-control"
                               placeholder="Enter contact number" />

                        <span asp-validation-for="CreateCompany.Phone"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ADDRESS -->

                    <div class="form-group">

                        <label asp-for="CreateCompany.Address">
                            Address
                        </label>

                        <textarea asp-for="CreateCompany.Address"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Enter company address"></textarea>

                        <span asp-validation-for="CreateCompany.Address"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- FOOTER -->

                <div class="modal-footer">

                    <button type="button"
                            class="btn-cancel"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn-save">

                        Create Company

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- UPDATE COMPANY MODAL -->
<!-- ============================================================= -->

<div class="modal fade"
     id="editCompanyModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content company-modal">

            <!-- HEADER -->

            <div class="modal-header">

                <div>

                    <h5 class="modal-title">
                        Update Company
                    </h5>

                    <p class="modal-subtitle">
                        Update company information
                    </p>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <!-- FORM -->

            <form method="post"
                  asp-page-handler="Edit">

                <div class="modal-body">

                    <!-- VALIDATION SUMMARY -->

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <!-- HIDDEN ID -->

                    <input asp-for="UpdateCompany.Id"
                           type="hidden"
                           id="editCompanyId" />


                    <!-- COMPANY NAME -->

                    <div class="form-group">

                        <label asp-for="UpdateCompany.Name">
                            Company Name
                        </label>

                        <input asp-for="UpdateCompany.Name"
                               id="editCompanyName"
                               class="form-control"
                               placeholder="Enter company name" />

                        <span asp-validation-for="UpdateCompany.Name"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- EMAIL -->

                    <div class="form-group">

                        <label asp-for="UpdateCompany.Email">
                            Email
                        </label>

                        <input asp-for="UpdateCompany.Email"
                               id="editCompanyEmail"
                               type="email"
                               class="form-control"
                               placeholder="company@example.com" />

                        <span asp-validation-for="UpdateCompany.Email"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- PHONE -->

                    <div class="form-group">

                        <label asp-for="UpdateCompany.Phone">
                            Contact Number
                        </label>

                        <input asp-for="UpdateCompany.Phone"
                               id="editCompanyPhone"
                               class="form-control"
                               placeholder="Enter contact number" />

                        <span asp-validation-for="UpdateCompany.Phone"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ADDRESS -->

                    <div class="form-group">

                        <label asp-for="UpdateCompany.Address">
                            Address
                        </label>

                        <textarea asp-for="UpdateCompany.Address"
                                  id="editCompanyAddress"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Enter company address"></textarea>

                        <span asp-validation-for="UpdateCompany.Address"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- STATUS -->

                    <div class="form-group">

                        <label asp-for="UpdateCompany.IsActive">
                            Status
                        </label>

                        <select asp-for="UpdateCompany.IsActive"
                                id="editCompanyStatus"
                                class="form-select">

                            <option value="true">
                                Active
                            </option>

                            <option value="false">
                                Inactive
                            </option>

                        </select>

                        <span asp-validation-for="UpdateCompany.IsActive"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- FOOTER -->

                <div class="modal-footer">

                    <button type="button"
                            class="btn-cancel"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn-save">

                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- DETAILS COMPANY MODAL -->
<!-- ============================================================= -->

<div class="modal fade"
     id="detailsCompanyModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content company-modal">

            <!-- HEADER -->

            <div class="modal-header">

                <div>

                    <h5 class="modal-title">
                        Company Details
                    </h5>

                    <p class="modal-subtitle">
                        Company information
                    </p>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <!-- BODY -->

            <div class="modal-body">

                <!-- COMPANY HEADER -->

                <div class="details-company-header">

                    <div class="details-avatar"
                         id="detailsAvatar">
                    </div>


                    <div>

                        <h4 id="detailsName">
                            -
                        </h4>

                        <span id="detailsStatus"
                              class="status-badge active">

                            Active

                        </span>

                    </div>

                </div>


                <!-- DETAILS -->

                <div class="details-grid">

                    <!-- EMAIL -->

                    <div class="detail-item">

                        <span class="detail-label">
                            Email
                        </span>

                        <span class="detail-value"
                              id="detailsEmail">

                            -

                        </span>

                    </div>


                    <!-- PHONE -->

                    <div class="detail-item">

                        <span class="detail-label">
                            Contact Number
                        </span>

                        <span class="detail-value"
                              id="detailsPhone">

                            -

                        </span>

                    </div>


                    <!-- ADDRESS -->

                    <div class="detail-item full-width">

                        <span class="detail-label">
                            Address
                        </span>

                        <span class="detail-value"
                              id="detailsAddress">

                            -

                        </span>

                    </div>


                    <!-- USERS -->

                    <div class="detail-stat">

                        <span class="stat-number"
                              id="detailsUsers">

                            0

                        </span>

                        <span class="stat-label">
                            Employees
                        </span>

                    </div>


                    <!-- PROJECTS -->

                    <div class="detail-stat">

                        <span class="stat-number"
                              id="detailsProjects">

                            0

                        </span>

                        <span class="stat-label">
                            Projects
                        </span>

                    </div>

                </div>

            </div>


            <!-- FOOTER -->

            <div class="modal-footer">

                <button type="button"
                        class="btn-cancel"
                        data-bs-dismiss="modal">

                    Close

                </button>

            </div>

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- SCRIPTS -->
<!-- ============================================================= -->
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            // =====================================================
            // SEARCH
            // =====================================================

            let searchTimer;

            const searchForm =
                document.getElementById("searchForm");

            const searchBox =
                document.getElementById("searchBox");


            if (searchBox && searchForm) {

                searchBox.addEventListener(
                    "input",
                    function() {

                        clearTimeout(searchTimer);

                        searchTimer = setTimeout(
                            function() {

                                // Always start from page 1
                                const pageInput =
                                    searchForm.querySelector(
                                        'input[name="Filter.PageNumber"]'
                                    );

                                if (pageInput) {
                                    pageInput.value = "1";
                                }

                                searchForm.submit();

                            },
                            700
                        );

                    }
                );

            }


            // =====================================================
            // STATUS FILTER
            // =====================================================

            const statusFilter =
                document.getElementById("statusFilter");


            if (statusFilter) {

                statusFilter.addEventListener(
                    "change",
                    function() {

                        const url =
                            new URL(
                                window.location.href
                            );


                        // Search term

                        url.searchParams.set(
                            "Filter.SearchTerm",
                            searchBox
                                ? searchBox.value
                                : ""
                        );


                        // Status

                        if (this.value === "") {

                            url.searchParams.delete(
                                "Filter.IsActive"
                            );

                        }
                        else {

                            url.searchParams.set(
                                "Filter.IsActive",
                                this.value
                            );

                        }


                        // Reset page

                        url.searchParams.set(
                            "Filter.PageNumber",
                            "1"
                        );


                        window.location.href =
                            url.toString();

                    }
                );

            }


            // =====================================================
            // EDIT COMPANY MODAL
            // =====================================================

            const editModal =
                document.getElementById(
                    "editCompanyModal"
                );


            if (editModal) {

                editModal.addEventListener(
                    "show.bs.modal",
                    function(event) {

                        const button =
                            event.relatedTarget;


                        if (!button) {
                            return;
                        }


                        // -----------------------------------------
                        // Read data from Edit button
                        // -----------------------------------------

                        const id =
                            button.getAttribute(
                                "data-id"
                            ) || "";

                        const name =
                            button.getAttribute(
                                "data-name"
                            ) || "";

                        const email =
                            button.getAttribute(
                                "data-email"
                            ) || "";

                        const phone =
                            button.getAttribute(
                                "data-phone"
                            ) || "";

                        const address =
                            button.getAttribute(
                                "data-address"
                            ) || "";

                        const active =
                            button.getAttribute(
                                "data-active"
                            ) || "true";


                        // -----------------------------------------
                        // Put data into form
                        // -----------------------------------------

                        const idInput =
                            document.getElementById(
                                "editCompanyId"
                            );

                        const nameInput =
                            document.getElementById(
                                "editCompanyName"
                            );

                        const emailInput =
                            document.getElementById(
                                "editCompanyEmail"
                            );

                        const phoneInput =
                            document.getElementById(
                                "editCompanyPhone"
                            );

                        const addressInput =
                            document.getElementById(
                                "editCompanyAddress"
                            );

                        const statusInput =
                            document.getElementById(
                                "editCompanyStatus"
                            );


                        if (idInput) {
                            idInput.value = id;
                        }

                        if (nameInput) {
                            nameInput.value = name;
                        }

                        if (emailInput) {
                            emailInput.value = email;
                        }

                        if (phoneInput) {
                            phoneInput.value = phone;
                        }

                        if (addressInput) {
                            addressInput.value = address;
                        }

                        if (statusInput) {

                            statusInput.value =
                                active.toLowerCase() === "true"
                                    ? "true"
                                    : "false";

                        }

                    }
                );

            }


            // =====================================================
            // DETAILS MODAL
            // =====================================================

            const detailsModal =
                document.getElementById(
                    "detailsCompanyModal"
                );


            if (detailsModal) {

                detailsModal.addEventListener(
                    "show.bs.modal",
                    function(event) {

                        const button =
                            event.relatedTarget;


                        if (!button) {
                            return;
                        }


                        const name =
                            button.getAttribute(
                                "data-name"
                            ) || "";

                        const email =
                            button.getAttribute(
                                "data-email"
                            ) || "";

                        const phone =
                            button.getAttribute(
                                "data-phone"
                            ) || "";

                        const address =
                            button.getAttribute(
                                "data-address"
                            ) || "";

                        const users =
                            button.getAttribute(
                                "data-users"
                            ) || "0";

                        const projects =
                            button.getAttribute(
                                "data-projects"
                            ) || "0";

                        const active =
                            button.getAttribute(
                                "data-active"
                            ) || "false";


                        // -----------------------------------------
                        // Avatar
                        // -----------------------------------------

                        const avatar =
                            document.getElementById(
                                "detailsAvatar"
                            );


                        if (avatar) {

                            avatar.textContent =
                                name.length > 0
                                    ? name
                                        .substring(0, 1)
                                        .toUpperCase()
                                    : "?";

                        }


                        // -----------------------------------------
                        // Name
                        // -----------------------------------------

                        const detailsName =
                            document.getElementById(
                                "detailsName"
                            );


                        if (detailsName) {
                            detailsName.textContent =
                                name || "-";
                        }


                        // -----------------------------------------
                        // Email
                        // -----------------------------------------

                        const detailsEmail =
                            document.getElementById(
                                "detailsEmail"
                            );


                        if (detailsEmail) {
                            detailsEmail.textContent =
                                email || "-";
                        }


                        // -----------------------------------------
                        // Phone
                        // -----------------------------------------

                        const detailsPhone =
                            document.getElementById(
                                "detailsPhone"
                            );


                        if (detailsPhone) {
                            detailsPhone.textContent =
                                phone || "-";
                        }


                        // -----------------------------------------
                        // Address
                        // -----------------------------------------

                        const detailsAddress =
                            document.getElementById(
                                "detailsAddress"
                            );


                        if (detailsAddress) {
                            detailsAddress.textContent =
                                address || "-";
                        }


                        // -----------------------------------------
                        // Users
                        // -----------------------------------------

                        const detailsUsers =
                            document.getElementById(
                                "detailsUsers"
                            );


                        if (detailsUsers) {
                            detailsUsers.textContent =
                                users;
                        }


                        // -----------------------------------------
                        // Projects
                        // -----------------------------------------

                        const detailsProjects =
                            document.getElementById(
                                "detailsProjects"
                            );


                        if (detailsProjects) {
                            detailsProjects.textContent =
                                projects;
                        }


                        // -----------------------------------------
                        // Status
                        // -----------------------------------------

                        const statusElement =
                            document.getElementById(
                                "detailsStatus"
                            );


                        if (statusElement) {

                            if (
                                active.toLowerCase() === "true"
                            ) {

                                statusElement.textContent =
                                    "Active";

                                statusElement.className =
                                    "status-badge active";

                            }
                            else {

                                statusElement.textContent =
                                    "Inactive";

                                statusElement.className =
                                    "status-badge inactive";

                            }

                        }

                    }
                );

            }


            // =====================================================
            // NAME SORT
            // =====================================================

            const sortSelect =
                document.getElementById(
                    "sortSelect"
                );


            if (sortSelect) {

                sortSelect.addEventListener(
                    "change",
                    function() {

                        const tbody =
                            document.querySelector(
                                ".company-table tbody"
                            );


                        if (!tbody) {
                            return;
                        }


                        const rows =
                            Array.from(
                                tbody.querySelectorAll(
                                    ".company-row"
                                )
                            );


                        rows.sort(
                            function(a, b) {

                                const nameA =
                                    (
                                        a.getAttribute(
                                            "data-name"
                                        ) || ""
                                    ).toLowerCase();


                                const nameB =
                                    (
                                        b.getAttribute(
                                            "data-name"
                                        ) || ""
                                    ).toLowerCase();


                                if (
                                    this.value === "name"
                                ) {

                                    return nameA.localeCompare(
                                        nameB
                                    );

                                }


                                return nameB.localeCompare(
                                    nameA
                                );

                            }.bind(this)
                        );


                        rows.forEach(
                            function(row) {

                                tbody.appendChild(
                                    row
                                );

                            }
                        );

                    }
                );

            }

        });

    </script>
}